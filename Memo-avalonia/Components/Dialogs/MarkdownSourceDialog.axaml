<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Memo.Components.Dialogs.MarkdownSourceDialog"
        Title="编辑 Markdown 源码"
        Icon="/Assets/appicon.ico"
        Width="680" Height="520"
        MinWidth="460" MinHeight="340"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="OnDialogKeyDown">
  <Window.Resources>
    <StreamGeometry x:Key="SourceDialogCodeIcon">M8,3A2,2 0 0,0 6,5V19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7L14,3H8M13,4.5L16.5,8H13V4.5M10.4,10.4L7.3,13.5L10.4,16.6L11.7,15.3L9.9,13.5L11.7,11.7L10.4,10.4M13.6,10.4L12.3,11.7L14.1,13.5L12.3,15.3L13.6,16.6L16.7,13.5L13.6,10.4Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.SourceChromeButton">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource IconDefaultBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}"/>
          <BrushTransition Property="Foreground" Duration="{DynamicResource MotionFastDuration}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SourceChromeButton:pointerover">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource IconHoverBrush}"/>
    </Style>
    <Style Selector="Button.SourceChromeButton:pressed">
      <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Button.SourceChromeButton PathIcon">
      <Setter Property="Foreground" Value="{StaticResource IconDefaultBrush}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="{DynamicResource MotionFastDuration}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SourceChromeButton:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource IconHoverBrush}"/>
    </Style>
    <Style Selector="Button.SourceChromeButton.close:pointerover">
      <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource DangerPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.SourceChromeButton.close:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource DangerPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.SourceChromeButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.SourceEditorFrame">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.SourceEditorFrame:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="Border.SourceEditorFrame:focus-within">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
    </Style>

    <Style Selector="TextBox.SourceEditorTextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource TextSelectionBrush}"/>
      <Setter Property="SelectionForegroundBrush" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="LineHeight" Value="21"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.SourceEditorTextBox /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.SourceEditorTextBox /template/ ScrollBar:vertical">
      <Setter Property="Width" Value="10"/>
    </Style>
    <Style Selector="TextBox.SourceEditorTextBox /template/ ScrollBar:horizontal">
      <Setter Property="Height" Value="10"/>
    </Style>

    <Style Selector="Button.SourceActionButton">
      <Setter Property="Height" Value="40"/>
      <Setter Property="MinWidth" Value="92"/>
      <Setter Property="Padding" Value="17,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}"/>
          <BrushTransition Property="Foreground" Duration="{DynamicResource MotionFastDuration}"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SourceActionButton.secondary">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.secondary:pointerover">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.secondary:pressed">
      <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.primary">
      <Setter Property="MinWidth" Value="118"/>
      <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.primary:pointerover">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.primary:pressed">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton.primary PathIcon">
      <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.SourceActionButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.SourceLanguageBadge">
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="Padding" Value="7,0"/>
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style Selector="Border.ResizeEdge">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Panel.ZIndex" Value="10"/>
    </Style>
    <Style Selector="Border.ResizeCorner">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Panel.ZIndex" Value="20"/>
    </Style>
  </Window.Styles>

  <Border x:Name="_dialogShell"
          Background="{StaticResource BgPrimaryBrush}"
          BorderBrush="{StaticResource BorderEmphasisBrush}"
          BorderThickness="1"
          CornerRadius="14"
          ClipToBounds="True"
          RenderTransformOrigin="50%,50%">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>

    <Grid RowDefinitions="64,1,*,1,68">
      <Grid Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="18,0,12,0"
            Background="{StaticResource TransparentBrush}">
        <Grid x:Name="_titleBar"
              Grid.Column="0"
              ColumnDefinitions="Auto,*"
              Background="{StaticResource TransparentBrush}"
              PointerPressed="OnTitleBarPointerPressed">
          <Border Width="36" Height="36"
                  VerticalAlignment="Center"
                  Background="{StaticResource AccentSubtleBrush}"
                  BorderBrush="{StaticResource AccentMutedBrush}"
                  BorderThickness="1"
                  CornerRadius="9">
            <PathIcon Data="{StaticResource SourceDialogCodeIcon}"
                      Width="18" Height="18"
                      Foreground="{StaticResource AccentPrimaryBrush}"/>
          </Border>
          <TextBlock Grid.Column="1"
                     Margin="11,0,0,0"
                     VerticalAlignment="Center"
                     Text="编辑 Markdown 源码"
                     FontSize="15.5"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Button Grid.Column="1"
                Classes="SourceChromeButton close"
                VerticalAlignment="Center"
                AutomationProperties.Name="关闭源码编辑面板"
                ToolTip.Tip="关闭"
                Click="OnCancel">
          <PathIcon Data="{StaticResource CloseIcon}" Width="14" Height="14"/>
        </Button>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource BorderSubtleBrush}"/>

      <Grid Grid.Row="2" Margin="20,16">
        <Border x:Name="_editorFrame"
                Classes="SourceEditorFrame"
                ClipToBounds="True">
          <Grid RowDefinitions="42,1,*">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="12,0"
                  Background="{StaticResource TransparentBrush}">
              <Border Classes="SourceLanguageBadge"
                      VerticalAlignment="Center">
                <TextBlock Text="MD"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"
                           FontSize="10.5"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}"/>
              </Border>
              <TextBlock Grid.Column="1"
                         Margin="9,0,0,0"
                         VerticalAlignment="Center"
                         Text="Markdown 源码"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextSecondaryBrush}"/>
              <TextBlock x:Name="_documentStatsText"
                         Grid.Column="2"
                         Margin="12,0,2,0"
                         VerticalAlignment="Center"
                         Text="1 行 · 0 字符"
                         FontSize="11.5"
                         Foreground="{StaticResource TextTertiaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource BorderSubtleBrush}"/>

            <TextBox x:Name="_sourceBox"
                     Grid.Row="2"
                     Classes="SourceEditorTextBox"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     AutomationProperties.Name="Markdown 源码"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     TextChanged="OnSourceTextChanged"/>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Background="{StaticResource BorderSubtleBrush}"/>

      <Grid Grid.Row="4"
            ColumnDefinitions="*,Auto,Auto"
            Margin="20,0"
            Background="{StaticResource TransparentBrush}">
        <Button Grid.Column="1"
                Classes="SourceActionButton secondary"
                Margin="0,0,9,0"
                Content="取消"
                AutomationProperties.Name="取消"
                Click="OnCancel"/>
        <Button x:Name="_applyButton"
                Grid.Column="2"
                Classes="SourceActionButton primary"
                AutomationProperties.Name="应用"
                Click="OnConfirm">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <PathIcon Data="{StaticResource MarkdownToolbarMenuCheckIcon}" Width="14" Height="14"/>
            <TextBlock Text="应用"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid x:Name="_resizeHandles" Grid.Row="0" Grid.RowSpan="5">
        <Border Classes="ResizeEdge"
                Tag="Top"
                Height="6" VerticalAlignment="Top"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeEdge"
                Tag="Bottom"
                Height="6" VerticalAlignment="Bottom"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeEdge"
                Tag="Left"
                Width="6" HorizontalAlignment="Left"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeEdge"
                Tag="Right"
                Width="6" HorizontalAlignment="Right"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeCorner"
                Tag="TopLeft"
                Width="14" Height="14"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeCorner"
                Tag="TopRight"
                Width="14" Height="14"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeCorner"
                Tag="BottomLeft"
                Width="14" Height="14"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                PointerPressed="OnResizeHandlePointerPressed"/>
        <Border Classes="ResizeCorner"
                Tag="BottomRight"
                Width="14" Height="14"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                PointerPressed="OnResizeHandlePointerPressed"/>
      </Grid>
    </Grid>
  </Border>
</Window>
