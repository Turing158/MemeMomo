<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Memo.Components.TimeWheelSelector">
  <UserControl.Styles>
    <Style Selector="Border.TimeWheelTrack">
      <Setter Property="Height" Value="98"/>
      <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Cursor" Value="SizeNorthSouth"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.TimeWheelTrack:pointerover">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="Border.TimeWheelTrack:focus">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
    </Style>

    <Style Selector="Button.TimeWheelStep">
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style Selector="Button.TimeWheelStep /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.TimeWheelStep:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
    </Style>
    <Style Selector="Button.TimeWheelStep:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>

    <Style Selector="Border.TimeWheelSelection">
      <Setter Property="Height" Value="32"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderThickness" Value="0,1"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="TextBlock.TimeWheelNumber">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="TextBlock.TimeWheelLabel">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,14,*,14,*" RowDefinitions="Auto,98">
    <TextBlock Grid.Column="0" Classes="TimeWheelLabel" Text="时"/>
    <TextBlock Grid.Column="2" Classes="TimeWheelLabel" Text="分"/>
    <TextBlock Grid.Column="4" Classes="TimeWheelLabel" Text="秒"/>

    <Border Grid.Row="1" Grid.Column="0"
            x:Name="_hourTrack"
            Classes="TimeWheelTrack"
            Tag="Hour"
            Focusable="True"
            ToolTip.Tip="滚轮、上下拖动或方向键调整小时"
            AutomationProperties.Name="小时"
            PointerPressed="OnWheelPointerPressed"
            PointerMoved="OnWheelPointerMoved"
            PointerReleased="OnWheelPointerReleased"
            PointerCaptureLost="OnWheelPointerCaptureLost"
            PointerWheelChanged="OnPointerWheelChanged"
            KeyDown="OnWheelKeyDown">
      <Grid ClipToBounds="True">
        <Border Classes="TimeWheelSelection"/>
        <Grid RowDefinitions="32,32,32">
          <Button Grid.Row="0" Classes="TimeWheelStep" Tag="Hour:-1" Click="OnStepClick" AutomationProperties.Name="上一小时"/>
          <Button Grid.Row="2" Classes="TimeWheelStep" Tag="Hour:1" Click="OnStepClick" AutomationProperties.Name="下一小时"/>
        </Grid>
        <StackPanel x:Name="_hourPrimaryStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
        <StackPanel x:Name="_hourBufferStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Grid.Column="1" Text=":" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <Border Grid.Row="1" Grid.Column="2"
            x:Name="_minuteTrack"
            Classes="TimeWheelTrack"
            Tag="Minute"
            Focusable="True"
            ToolTip.Tip="滚轮、上下拖动或方向键调整分钟"
            AutomationProperties.Name="分钟"
            PointerPressed="OnWheelPointerPressed"
            PointerMoved="OnWheelPointerMoved"
            PointerReleased="OnWheelPointerReleased"
            PointerCaptureLost="OnWheelPointerCaptureLost"
            PointerWheelChanged="OnPointerWheelChanged"
            KeyDown="OnWheelKeyDown">
      <Grid ClipToBounds="True">
        <Border Classes="TimeWheelSelection"/>
        <Grid RowDefinitions="32,32,32">
          <Button Grid.Row="0" Classes="TimeWheelStep" Tag="Minute:-1" Click="OnStepClick" AutomationProperties.Name="上一分钟"/>
          <Button Grid.Row="2" Classes="TimeWheelStep" Tag="Minute:1" Click="OnStepClick" AutomationProperties.Name="下一分钟"/>
        </Grid>
        <StackPanel x:Name="_minutePrimaryStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
        <StackPanel x:Name="_minuteBufferStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Grid.Column="3" Text=":" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

    <Border Grid.Row="1" Grid.Column="4"
            x:Name="_secondTrack"
            Classes="TimeWheelTrack"
            Tag="Second"
            Focusable="True"
            ToolTip.Tip="滚轮、上下拖动或方向键调整秒钟"
            AutomationProperties.Name="秒钟"
            PointerPressed="OnWheelPointerPressed"
            PointerMoved="OnWheelPointerMoved"
            PointerReleased="OnWheelPointerReleased"
            PointerCaptureLost="OnWheelPointerCaptureLost"
            PointerWheelChanged="OnPointerWheelChanged"
            KeyDown="OnWheelKeyDown">
      <Grid ClipToBounds="True">
        <Border Classes="TimeWheelSelection"/>
        <Grid RowDefinitions="32,32,32">
          <Button Grid.Row="0" Classes="TimeWheelStep" Tag="Second:-1" Click="OnStepClick" AutomationProperties.Name="上一秒"/>
          <Button Grid.Row="2" Classes="TimeWheelStep" Tag="Second:1" Click="OnStepClick" AutomationProperties.Name="下一秒"/>
        </Grid>
        <StackPanel x:Name="_secondPrimaryStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
        <StackPanel x:Name="_secondBufferStrip" VerticalAlignment="Top" IsHitTestVisible="False">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
