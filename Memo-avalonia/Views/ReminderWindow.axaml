<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="using:Memo.Components"
        x:Class="Memo.Views.ReminderWindow"
        Title="设置提醒"
        Icon="/Assets/appicon.ico"
        Width="360" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <Window.Resources>
    <StreamGeometry x:Key="ReminderCalendarIcon">M19,4H18V2H16V4H8V2H6V4H5C3.89,4 3,4.89 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.89 20.1,4 19,4M19,20H5V9H19V20M19,7H5V6H19V7M7,11H12V16H7V11Z</StreamGeometry>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.ReminderIconBtn">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.ReminderIconBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ReminderIconBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
    </Style>
    <Style Selector="Button.ReminderIconBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
    </Style>
    <Style Selector="Button.ReminderIconBtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ReminderIconBtn PathIcon">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ReminderIconBtn:pointerover PathIcon">
      <Setter Property="Foreground" Value="{StaticResource IconHoverBrush}"/>
    </Style>

    <Style Selector="Border.ReminderCard">
      <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="Button.ReminderQuickBtn">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="5,0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ReminderQuickBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ReminderQuickBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentMutedBrush}"/>
    </Style>
    <Style Selector="Button.ReminderQuickBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.ReminderQuickBtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
    </Style>

    <Style Selector="Button.ReminderSecondaryBtn, Button.ReminderPrimaryBtn, Button.ReminderCancelBtn">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.ReminderSecondaryBtn">
      <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.ReminderPrimaryBtn">
      <Setter Property="Background" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.ReminderCancelBtn">
      <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource DangerPrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource DangerPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.ReminderSecondaryBtn /template/ ContentPresenter#PART_ContentPresenter, Button.ReminderPrimaryBtn /template/ ContentPresenter#PART_ContentPresenter, Button.ReminderCancelBtn /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionStandardDuration}" Easing="CubicEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionStandardDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ReminderSecondaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="Button.ReminderSecondaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceActiveBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderEmphasisBrush}"/>
    </Style>
    <Style Selector="Button.ReminderPrimaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.ReminderPrimaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.ReminderCancelBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.ReminderCancelBtn:pointerover">
      <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
    </Style>
    <Style Selector="Button.ReminderSecondaryBtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.ReminderPrimaryBtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.ReminderCancelBtn:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ReminderPrimaryBtn:disabled, Button.ReminderCancelBtn:disabled">
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style Selector="Border.ReminderDateField">
      <Setter Property="Height" Value="42"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
          <BrushTransition Property="BorderBrush" Duration="{DynamicResource MotionFastDuration}" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.ReminderDateField:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker">
      <Setter Property="Height" Value="40"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker:pointerover /template/ Border#Background, CalendarDatePicker.ReminderDatePicker:pressed /template/ Border#Background, CalendarDatePicker.ReminderDatePicker:focus-within /template/ Border#Background">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ TextBox#PART_TextBox">
      <Setter Property="Padding" Value="40,0,0,0"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8,0,0,8"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, CalendarDatePicker.ReminderDatePicker /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement, CalendarDatePicker.ReminderDatePicker /template/ TextBox#PART_TextBox:focus-within /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ Button#PART_Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="MinWidth" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{StaticResource TransparentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
      <Setter Property="BorderThickness" Value="1,0,0,0"/>
      <Setter Property="CornerRadius" Value="0,8,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusAdorner" Value="{x:Null}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PART_DateButtonSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
          <PathIcon Data="{StaticResource ReminderCalendarIcon}"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource AccentPrimaryBrush}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ Button#PART_Button:pointerover /template/ Border#PART_DateButtonSurface">
      <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ Button#PART_Button:pressed /template/ Border#PART_DateButtonSurface">
      <Setter Property="Background" Value="{StaticResource AccentMutedBrush}"/>
    </Style>
    <Style Selector="CalendarDatePicker.ReminderDatePicker /template/ Button#PART_Button PathIcon">
      <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="TextBlock.ReminderDateLabel">
      <Setter Property="Margin" Value="13,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style Selector="Border.ReminderDateField:focus-within TextBlock.ReminderDateLabel">
      <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
    </Style>
  </Window.Styles>

  <Border x:Name="_reminderShell"
          Background="{StaticResource BgPrimaryBrush}"
          BorderBrush="{StaticResource BorderSubtleBrush}"
          BorderThickness="1"
          CornerRadius="14"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <ScaleTransform ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>

    <Grid RowDefinitions="48,*">
      <Border Grid.Row="0"
              Background="{StaticResource SurfacePrimaryBrush}"
              BorderBrush="{StaticResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="14,14,0,0"
              PointerPressed="OnTitleBarPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="16,0,10,0">
          <Border Background="Transparent">
            <TextBlock Text="设置提醒"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
          </Border>
          <Button Grid.Column="1"
                  Classes="ReminderIconBtn"
                  Click="OnCloseClick"
                  AutomationProperties.Name="关闭提醒设置">
            <PathIcon Data="{StaticResource CloseIcon}"
                      Width="15"
                      Height="15"
                      Foreground="{StaticResource IconDefaultBrush}"/>
          </Button>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="16,14,16,16" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Spacing="3">
          <TextBlock x:Name="_memoTitleText"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="_currentReminderText"
                     FontSize="11.5"
                     Foreground="{StaticResource TextTertiaryBrush}"
                     IsVisible="False"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,10,0,0" Classes="ReminderCard">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,*,*,*">
              <Button Grid.Column="0" Classes="ReminderQuickBtn" Margin="0,0,3,0" Content="1分钟后" Tag="60" Click="OnQuickTimeClick" AutomationProperties.Name="设置为1分钟后"/>
              <Button Grid.Column="1" Classes="ReminderQuickBtn" Margin="3,0" Content="10分钟后" Tag="600" Click="OnQuickTimeClick" AutomationProperties.Name="设置为10分钟后"/>
              <Button Grid.Column="2" Classes="ReminderQuickBtn" Margin="3,0" Content="半小时后" Tag="1800" Click="OnQuickTimeClick" AutomationProperties.Name="设置为半小时后"/>
              <Button Grid.Column="3" Classes="ReminderQuickBtn" Margin="3,0,0,0" Content="1小时后" Tag="3600" Click="OnQuickTimeClick" AutomationProperties.Name="设置为1小时后"/>
            </Grid>

            <Border Classes="ReminderDateField">
              <Grid>
                <CalendarDatePicker x:Name="_datePicker"
                                    Classes="ReminderDatePicker"
                                    Watermark="选择日期"
                                    SelectedDateFormat="Custom"
                                    CustomDateFormatString="yyyy-MM-dd"
                                    SelectedDateChanged="OnSelectedDateChanged"
                                    DateValidationError="OnDateValidationError"
                                    ToolTip.Tip="输入日期或打开日历选择"
                                    AutomationProperties.Name="提醒日期"/>
                <TextBlock Classes="ReminderDateLabel" Text="提醒日期"/>
              </Grid>
            </Border>

            <components:TimeWheelSelector x:Name="_timeWheel"
                                          AutomationProperties.Name="提醒时间"/>
          </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   x:Name="_errorText"
                   MinHeight="18"
                   Margin="0,6"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="11.5"
                   Foreground="{StaticResource DangerPrimaryBrush}"/>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto">
          <Button x:Name="_cancelReminderButton"
                  Classes="ReminderCancelBtn"
                  Content="取消提醒"
                  IsVisible="False"
                  Click="OnCancelReminderClick"
                  AutomationProperties.Name="取消当前提醒"/>
          <Button Grid.Column="1"
                  Classes="ReminderSecondaryBtn"
                  Margin="8,0,0,0"
                  Content="取消"
                  Click="OnCloseClick"/>
          <Button Grid.Column="2"
                  x:Name="_scheduleButton"
                  Classes="ReminderPrimaryBtn"
                  Margin="8,0,0,0"
                  Content="设置提醒"
                  Click="OnScheduleClick"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
