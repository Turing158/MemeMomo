<windows:BorderlessWindow x:Class="Memo.MainWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:windows="clr-namespace:Memo.UI.Windows"
                          xmlns:ui="clr-namespace:Memo.UI"
                          xmlns:models="clr-namespace:Memo.Models"
                          xmlns:components="clr-namespace:Memo.Components"
                          Title="备忘录"
                          Width="420"
                          Height="680"
                          MinWidth="360"
                          MinHeight="480"
                          WindowStartupLocation="CenterScreen"
                          ShowInTaskbar="False"
                          UseBuiltInTitleBar="False"
                          ResizeMode="CanResize"
                          CornerRadius="14"
                          TitleBarHeight="49"
                          Background="Transparent"
                          PreviewKeyDown="OnWindowPreviewKeyDown"
                          PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp">
  <windows:BorderlessWindow.Resources>
    <ui:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />
    <ui:PositiveCountToVisibilityConverter x:Key="PositiveCountVisibility" />
    <ui:EmptyStringToVisibilityConverter x:Key="EmptyStringVisibility" />
    <DataTemplate x:Key="MemoItemTemplate" DataType="{x:Type models:MemoItem}">
      <Border x:Name="MemoCard"
              Style="{StaticResource MemoCardStyle}"
              Margin="0,0,0,10"
              Padding="0"
              MouseEnter="OnMemoCardMouseEnter"
              MouseLeave="OnMemoCardMouseLeave"
              PreviewMouseLeftButtonDown="OnMemoCardPreviewMouseLeftButtonDown">
        <Grid x:Name="MemoCardMotionSurface">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  x:Name="AccentBar"
                  Width="3"
                  Margin="0,10,0,10"
                  CornerRadius="2"
                  Background="{DynamicResource AccentPrimaryBrush}"
                  Opacity="0.5" />
          <Grid Grid.Column="1" Margin="13,14,8,14">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Title}"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         Margin="0,0,8,0" />
              <Button x:Name="DeleteButton"
                      Grid.Column="1"
                      Style="{StaticResource DeleteButtonStyle}"
                      AutomationProperties.Name="删除备忘录"
                      ToolTip="删除"
                      Click="OnDeleteClick"
                      PreviewMouseLeftButtonDown="OnDeleteButtonPreviewMouseLeftButtonDown">
                <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource DeleteXIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,5,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                         Text="{Binding Subtitle}"
                         Visibility="{Binding Subtitle, Converter={StaticResource EmptyStringVisibility}}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RelativeTime}"
                         FontSize="10.5"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         Margin="10,0,0,0" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </windows:BorderlessWindow.Resources>

  <!-- Keep the window host transparent so the dock handle is the only visible
       surface while the native dock region is active. ExpandedSurface owns the
       normal window backgrounds. -->
  <Grid x:Name="WindowRoot" Background="Transparent">
    <Grid x:Name="ExpandedSurface" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="49" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource SurfacePrimaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="0"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="22" Height="22" Source="/Memo;component/Assets/appicon.png" />
            <TextBlock Margin="10,0,0,0" Text="备忘录" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Margin="10,0,0,0" Style="{StaticResource CountBadgeStyle}" Visibility="{Binding Memos.Count, Converter={StaticResource PositiveCountVisibility}}">
              <TextBlock Text="{Binding Memos.Count}" Style="{StaticResource CountBadgeTextStyle}" />
            </Border>
          </StackPanel>
          <Border Grid.Column="1" Background="Transparent" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SettingsButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="设置" ToolTip="设置" Click="OnSettingsClick">
              <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource SettingsIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="置顶" ToolTip="置顶" Click="OnPinClick">
              <Path x:Name="PinIcon" Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource PinIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="最小化" ToolTip="最小化" Click="OnMinimizeClick">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MinimizeIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="关闭" ToolTip="关闭" Click="OnCloseClick" ui:InteractionState.IsDanger="True">
              <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource BgPrimaryBrush}" CornerRadius="0">
      <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:MarkdownEditor x:Name="MarkdownEditor"
                                   Grid.Row="0"
                                   MinHeight="110"
                                   MaxHeight="230"
                                   Margin="0,0,0,10"
                                   ShowNewAction="True" />
        <Grid Grid.Row="1">
          <Border Style="{StaticResource EmptyStateCardStyle}"
                  Visibility="{Binding Memos.Count, Converter={StaticResource ZeroCountVisibility}}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="20,40">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center">
                <Path Width="24" Height="24" Stretch="Uniform" Data="{DynamicResource ChevronDownIcon}" Fill="{DynamicResource AccentMutedBrush}" />
              </Border>
              <TextBlock Margin="0,12,0,0" Text="还没有备忘录" Style="{StaticResource EmptyHintTitleStyle}" />
              <TextBlock Margin="0,4,0,0" Text="在上方写下第一条 Markdown 备忘录&#x0a;按 Ctrl+Enter 新增" Style="{StaticResource EmptyHintSubtitleStyle}" />
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="MemoScrollViewer"
                        Visibility="{Binding Memos.Count, Converter={StaticResource PositiveCountVisibility}}"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        ScrollChanged="OnMemoScrollViewerScrollChanged">
            <ItemsControl x:Name="MemoList" ItemsSource="{Binding Memos}" ItemTemplate="{StaticResource MemoItemTemplate}" Padding="6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- Drag preview needs every card realized so insertion stays
                       deterministic while the list auto-scrolls. -->
                  <StackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          <ScrollBar x:Name="MemoOverlayScrollBar"
                     Panel.ZIndex="25"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Stretch"
                     Orientation="Vertical"
                     Style="{StaticResource EditorOverlayScrollBarStyle}"
                     Visibility="Collapsed"
                     ValueChanged="OnMemoOverlayScrollBarValueChanged"
                     PreviewMouseLeftButtonDown="OnMemoOverlayScrollBarPreviewMouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="OnMemoOverlayScrollBarPreviewMouseLeftButtonUp"
                     LostMouseCapture="OnMemoOverlayScrollBarLostMouseCapture"
                     Loaded="OnMemoOverlayScrollBarLoaded" />
          <Canvas x:Name="DeleteOverlay" IsHitTestVisible="False" Panel.ZIndex="20" ClipToBounds="True" />
        </Grid>
      </Grid>
      </Border>
    </Grid>

    <Grid x:Name="DockLayer"
          Panel.ZIndex="50"
          Opacity="0"
          IsHitTestVisible="False"
          ToolTip="按住拖动可沿屏幕边缘移动；向内拖动可恢复窗口"
          AutomationProperties.Name="贴边窗口拖动手柄"
          ClipToBounds="True"
          MouseLeftButtonDown="OnDockMouseLeftButtonDown"
          MouseRightButtonDown="OnDockMouseRightButtonDown"
          MouseRightButtonUp="OnDockMouseRightButtonUp">
      <Grid x:Name="DockVisual"
            Width="44"
            Height="44"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderTransformOrigin="0.5,0.5"
            IsHitTestVisible="False">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Grid.RenderTransform>
        <Path x:Name="DockShape"
              Fill="{DynamicResource SurfacePrimaryBrush}"
              Stretch="Fill"
              IsHitTestVisible="False" />
        <Path x:Name="DockOutline"
              Fill="Transparent"
              Stroke="{DynamicResource BorderSubtleBrush}"
              StrokeThickness="1"
              Opacity="0.55"
              Stretch="Fill"
              IsHitTestVisible="False" />
        <Border x:Name="DockIconSurface"
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="False">
          <Image Width="24" Height="24" Source="/Memo;component/Assets/appicon.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <Border x:Name="DockContent"
              Width="44"
              Height="44"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="Transparent" />
    </Grid>
  </Grid>
</windows:BorderlessWindow>
