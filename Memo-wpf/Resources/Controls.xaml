<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Memo.UI"
                    xmlns:windows="clr-namespace:Memo.UI.Windows">
  <Style x:Key="MemoFocusVisualStyle" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource BorderFocusBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusSm}"
                  IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

    <Style x:Key="MemoBaseButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource MemoFocusVisualStyle}" />
    <Setter Property="ui:InteractionAnimations.Profile" Value="Button" />
    <Setter Property="ui:InteractionAnimations.TargetName" Value="ButtonContent" />
    <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="ButtonHoverLayer" />
    <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="ButtonPressedLayer" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="ButtonSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding ui:CornerRadiusProxy.Value}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="ButtonHoverLayer"
                      CornerRadius="{Binding Path=(ui:CornerRadiusProxy.Value), RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{Binding Path=(ui:InteractionAnimations.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="ButtonPressedLayer"
                      CornerRadius="{Binding Path=(ui:CornerRadiusProxy.Value), RelativeSource={RelativeSource TemplatedParent}}"
                      Background="{Binding Path=(ui:InteractionAnimations.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="ButtonContent"
                      Background="Transparent"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsPinActive), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
              <Setter TargetName="ButtonHoverLayer" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsDanger), RelativeSource={RelativeSource TemplatedParent}}" Value="True">
              <Setter TargetName="ButtonHoverLayer" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
              <Setter TargetName="ButtonPressedLayer" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MemoButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MemoBaseButtonStyle}" />
  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource MemoButtonStyle}" />

  <Style x:Key="TitleBarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource IconDefaultBrush}" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <!-- Keep the chrome button itself stable; only its icon/content surface moves. -->
    <Setter Property="ui:InteractionAnimations.HoverScale" Value="1.10" />
    <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.88" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource BorderDefaultBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsPinActive), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsDanger), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备忘录卡片。悬停时的强调边框不直接改卡片 BorderBrush（那会瞬时跳变），
       而是由模板内的 MemoCardBorderLayer 层承担：引擎把 hover 与 pressed 层
       透明度都指向该层，于是悬停淡入、按住保持、移出淡出。卡片自身边框
       保持默认色，仅保留编辑态（非悬停）与按压底色的瞬时切换。 -->
  <Style x:Key="MemoCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Height" Value="76" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ui:InteractionAnimations.Profile" Value="Surface" />
    <Setter Property="ui:InteractionAnimations.TargetName" Value="MemoCardMotionSurface" />
    <Setter Property="ui:InteractionAnimations.HoverScale" Value="1.003" />
    <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.99" />
    <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="MemoCardBorderLayer" />
    <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="MemoCardBorderLayer" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsPressed), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsEditing), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- 备忘录卡片悬停边框层：默认 Opacity 0，由 InteractionAnimations 引擎随
       hover/press 驱动淡入淡出。Margin -1 抵消卡片 1px 边框内缩，使描边
       精确覆盖卡片原边框；不参与命中测试，避免影响点击与拖拽。 -->
  <Style x:Key="MemoCardBorderLayerStyle" TargetType="{x:Type Border}">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="-1" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style x:Key="DeleteButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleBarButtonStyle}">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource IconDefaultBrush}" />
    <Setter Property="ui:InteractionAnimations.HoverScale" Value="1.04" />
    <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.96" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource DangerSubtleBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource DangerSubtleBrush}" />
    <Setter Property="ui:InteractionState.TrackPointerState" Value="True" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding (ui:InteractionState.IsRevealed), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Opacity" Value="1" />
      </DataTrigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="InputRootStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="InputBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" />
    <Setter Property="SelectionTextBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="PART_BorderElement"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource InputBoxStyle}" />

  <Style x:Key="EmptyHintTitleStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style x:Key="EmptyHintSubtitleStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style x:Key="CountBadgeStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="CountBadgeTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="EmptyStateCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="32,28" />
  </Style>

  <!--
    Shared overlay scrollbar for the MarkdownEditor (main window and popout
    memo) and the main window's memo list overlay: a hairline thumb on an
    invisible track that fades in and widens to half the legacy scrollbar
    width while hovered.  The strip keeps a constant width so wrapped text
    never reflows when the thumb expands.  The thumb also stays expanded while
    InteractionState.IsRevealed holds — the memo list sets it for a second
    after a drag ends so the bar does not snap thin under the user's eye.
  -->
  <Style x:Key="EditorOverlayScrollBarRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EditorOverlayScrollBarThumbStyle" TargetType="{x:Type Thumb}">
    <!-- Expanded accent is the base look; the idle trigger below mutes it. -->
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <!-- CornerRadius 4 clamps to a pill at both 4px and 8px widths. -->
          <Border x:Name="ThumbVisual"
                  Width="4"
                  HorizontalAlignment="Right"
                  Margin="0,1"
                  Background="{TemplateBinding Background}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
              <Setter TargetName="ThumbVisual" Property="Width" Value="Auto" />
              <Setter TargetName="ThumbVisual" Property="Height" Value="4" />
              <Setter TargetName="ThumbVisual" Property="HorizontalAlignment" Value="Stretch" />
              <Setter TargetName="ThumbVisual" Property="VerticalAlignment" Value="Bottom" />
              <Setter TargetName="ThumbVisual" Property="Margin" Value="1,0" />
            </DataTrigger>
            <!-- Idle hairline. The thumb expands while the pointer is over the
                 scrollbar OR while InteractionState.IsRevealed holds (the memo
                 list's release grace); only when both states leave does this
                 trigger activate and thin it again, so one trigger owns the
                 width animation and the two states never fight. -->
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="False" />
                <Condition Binding="{Binding Path=(ui:InteractionState.IsRevealed), RelativeSource={RelativeSource TemplatedParent}}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbVisual"
                                     Storyboard.TargetProperty="Width"
                                     To="4"
                                     Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbVisual"
                                     Storyboard.TargetProperty="Width"
                                     To="8"
                                     Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True" />
                <Condition Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbVisual"
                                     Storyboard.TargetProperty="Height"
                                     To="8"
                                     Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.EnterActions>
              <MultiDataTrigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ThumbVisual"
                                     Storyboard.TargetProperty="Height"
                                     To="4"
                                     Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EditorOverlayScrollBarStyle" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="TrackVisual"
                    HorizontalAlignment="Right"
                    Width="10"
                    Margin="0,1"
                    Background="{DynamicResource BgTertiaryBrush}"
                    CornerRadius="4"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <Track x:Name="PART_Track"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Focusable="False">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{StaticResource EditorOverlayScrollBarRepeatButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource EditorOverlayScrollBarThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              Style="{StaticResource EditorOverlayScrollBarRepeatButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="TrackVisual" Property="Width" Value="Auto" />
              <Setter TargetName="TrackVisual" Property="Height" Value="10" />
              <Setter TargetName="TrackVisual" Property="HorizontalAlignment" Value="Stretch" />
              <Setter TargetName="TrackVisual" Property="VerticalAlignment" Value="Bottom" />
              <Setter TargetName="TrackVisual" Property="Margin" Value="1,0" />
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="10" />
              <Setter Property="MinHeight" Value="10" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackVisual"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.55"
                                     Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackVisual"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0"
                                     Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MarkdownEditorSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style x:Key="MarkdownEditorToolbarStyle" TargetType="Border">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="9,9,0,0" />
  </Style>

    <Style x:Key="MarkdownToolButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Width" Value="29" />
    <Setter Property="Height" Value="29" />
    <Setter Property="MinWidth" Value="29" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource IconDefaultBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="6" />
    <!-- Keep the toolbar hit target stable and animate only its inner content.
         The amplitude is stronger than a regular button, but below the custom
         title-bar button motion (1.10 / 0.88). -->
    <Setter Property="ui:InteractionAnimations.HoverScale" Value="1.07" />
    <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.92" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="ButtonHoverLayer"
                      CornerRadius="6"
                      Background="{Binding Path=(ui:InteractionAnimations.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="ButtonPressedLayer"
                      CornerRadius="6"
                      Background="{Binding Path=(ui:InteractionAnimations.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Grid x:Name="ButtonContent" RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MarkdownSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MarkdownToolButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessHoverBrush}" />
  </Style>

  <!-- Mirrors the Avalonia CodeBlockCopyButton: opaque card-coloured chip that
       floats over the code block card, with brush-only hover/pressed states. -->
  <Style x:Key="CodeBlockCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource IconDefaultBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonSurface"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="7"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource BgHoverBrush}" />
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceActiveBrush}" />
              <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DialogInputRootStyle" TargetType="Border">
    <Setter Property="Height" Value="44" />
    <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" /></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsInvalid), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerPrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="DialogIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="8" />
  </Style>

  <Style x:Key="DialogInputIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogIconButtonStyle}">
    <Setter Property="ui:InteractionAnimations.HoverScale" Value="1.04" />
    <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.95" />
  </Style>

  <Style x:Key="DialogActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Height" Value="38" />
    <Setter Property="MinWidth" Value="84" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="8" />
  </Style>

  <Style x:Key="DialogSecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- DateFieldSelector: 月份导航按钮。透明常态，hover/press 由基样式的两层承担。
       箭头由各按钮自带 Path 内容提供（旋转 ChevronDownIcon），Fill 绑到本样式的
       Foreground，以便 hover 时随 IconHoverBrush 一起变化。 -->
  <Style x:Key="CalendarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource IconDefaultBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="6" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- DateFieldSelector: 日期格。选中态与今日态由 InteractionState 触发器驱动，
       两者重合时只呈现选中态（选中 setter 位于今日 setter 之后）。 -->
  <Style x:Key="CalendarDayCellStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="6" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsRevealed), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsSelected), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource AccentPressedBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- DateFieldSelector: 相邻月日期格。文字降级，其余与当月一致。 -->
  <Style x:Key="CalendarAdjacentDayCellStyle" TargetType="Button" BasedOn="{StaticResource CalendarDayCellStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!-- DateFieldSelector: 标题按钮（年月 / 年份 / 年份区间）。透明常态，点击逐级上钻。 -->
  <Style x:Key="CalendarHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:CornerRadiusProxy.Value" Value="6" />
  </Style>

  <!-- DateFieldSelector: 月份格与年份格。与日期格同源，仅尺寸与字号不同。 -->
  <Style x:Key="CalendarUnitCellStyle" TargetType="Button" BasedOn="{StaticResource CalendarDayCellStyle}">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- DateFieldSelector: 年份视图里越出当前区间的补位年份，文字降级。 -->
  <Style x:Key="CalendarAdjacentUnitCellStyle" TargetType="Button" BasedOn="{StaticResource CalendarUnitCellStyle}">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

    <Style x:Key="DialogPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
    <Setter Property="MinWidth" Value="116" />
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource AccentHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource AccentPressedBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Opacity" Value="0.78" />
      </Trigger>
    </Style.Triggers>
  </Style>

    <Style x:Key="DialogDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogActionButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource DangerPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerPrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource DangerHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource DangerHoverBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource DangerPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource BgPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

    <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="StaysOpenOnClick" Value="True" />
    <Setter Property="ui:InteractionAnimations.Profile" Value="MenuItem" />
    <Setter Property="ui:InteractionAnimations.TargetName" Value="MenuItemContent" />
    <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="MenuItemHoverLayer" />
    <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="MenuItemPressedLayer" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="MenuItemSurface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="MenuItemHoverLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="MenuItemPressedLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="MenuItemContent"
                      Background="Transparent"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter ContentSource="Header"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.42" />
            </Trigger>
            <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsDanger), RelativeSource={RelativeSource Self}}" Value="True">
              <Setter TargetName="MenuItemSurface" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="12"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ScrollViewer CanContentScroll="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
