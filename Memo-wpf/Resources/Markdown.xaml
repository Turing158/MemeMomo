<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Memo.UI">
    <Style x:Key="MarkdownTableEdgeButtonTheme" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ui:InteractionAnimations.Profile" Value="Button" />
    <Setter Property="ui:InteractionAnimations.TargetName" Value="ButtonContent" />
    <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="ButtonHoverLayer" />
    <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="ButtonPressedLayer" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <Grid>
              <Border x:Name="ButtonHoverLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="ButtonPressedLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="ButtonContent"
                      Background="Transparent"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MarkdownTableEdgeMenuPresenterTheme" TargetType="{x:Type ContextMenu}">
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

    <Style x:Key="MarkdownTableEdgeMenuItemTheme" TargetType="{x:Type MenuItem}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="StaysOpenOnClick" Value="True" />
    <Setter Property="ui:InteractionAnimations.Profile" Value="MenuItem" />
    <Setter Property="ui:InteractionAnimations.TargetName" Value="MenuItemContent" />
    <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="MenuItemHoverLayer" />
    <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="MenuItemPressedLayer" />
    <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource BgHoverBrush}" />
    <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="MenuItemSurface" Background="{TemplateBinding Background}" CornerRadius="8">
            <Grid>
              <Border x:Name="MenuItemHoverLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="MenuItemPressedLayer"
                      CornerRadius="8"
                      Background="{Binding Path=(ui:InteractionAnimations.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}"
                      Opacity="0" />
              <Border x:Name="MenuItemContent"
                      Background="Transparent"
                      Padding="{TemplateBinding Padding}"
                      RenderTransformOrigin="0.5,0.5">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource IconHoverBrush}" />
      </Trigger>
      <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsDanger), RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
      </DataTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="MarkdownToolbarMenuPresenterTheme" TargetType="{x:Type ContextMenu}">
    <Setter Property="MinWidth" Value="124" />
    <Setter Property="MaxHeight" Value="520" />
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- WPF has no FlyoutPresenter; this keyed Border style is the equivalent surface host. -->
  <Style x:Key="MarkdownTablePickerPresenterTheme" TargetType="{x:Type Border}">
    <Setter Property="MinWidth" Value="205" />
    <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <Style x:Key="MarkdownToolbarMenuItemTheme" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource MarkdownTableEdgeMenuItemTheme}">
    <Setter Property="Height" Value="34" />
  </Style>
  <Style x:Key="MarkdownToolbarMenuSeparatorTheme" TargetType="{x:Type Separator}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="8,5" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
