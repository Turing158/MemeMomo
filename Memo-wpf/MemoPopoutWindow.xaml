<windows:BorderlessWindow x:Class="Memo.MemoPopoutWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:windows="clr-namespace:Memo.UI.Windows"
                          xmlns:components="clr-namespace:Memo.Components"
                          xmlns:ui="clr-namespace:Memo.UI"
                          Title="备忘录"
                          Width="360"
                          Height="280"
                          MinWidth="280"
                          MinHeight="180"
                          WindowStartupLocation="Manual"
                          ShowInTaskbar="False"
                          UseBuiltInTitleBar="False"
                          ResizeMode="CanResize"
                          CornerRadius="14"
                          TitleBarHeight="38"
                          PreviewKeyDown="OnWindowPreviewKeyDown">
  <!-- 便签内容（标题行 38 + 编辑器）放在内层 Grid；贴边态窗口高度 32 < 38，
       固定行不收缩会让跨行元素的布局槽超出窗口，因此 D 形标签挂在外层根 Grid，
       布局高度始终等于窗口实际高度，保证标签内容上下居中。
       贴边预览期控制器会把 MemoHost 宽度冻结锚定贴边侧并动画收拢到标签宽度
       （BeginGhostCollapse），使半透明残影朝贴边方向收拢，而非随贴边条矩形拉伸。
       WindowRoot 不设背景：窗口为逐像素透明，浮动圆角与贴边 D 形圆弧均由
       WPF 自绘抗锯齿边缘，圆弧外像素保持透明并穿透点击。 -->
  <Grid x:Name="WindowRoot">
    <Grid x:Name="MemoHost">
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource BgPrimaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="14,14,0,0"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid Margin="11,0,7,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Width="18" Height="18" Source="/Memo;component/Assets/appicon.png" VerticalAlignment="Center" />
          <TextBlock x:Name="TitleText"
                     Grid.Column="1"
                     Margin="8,0,4,0"
                     VerticalAlignment="Center"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Text="备忘录"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ReminderButton"
                    Width="25" Height="25" Padding="0"
                    Style="{StaticResource TitleBarButtonStyle}"
                    AutomationProperties.Name="设置提醒"
                    ToolTip="设置提醒"
                    Click="OnReminderClick">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource ReminderIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="ToolbarButton"
                    Width="25" Height="25" Padding="0"
                    Style="{StaticResource TitleBarButtonStyle}"
                    AutomationProperties.Name="显示 Markdown 工具栏"
                    ToolTip="显示 Markdown 工具栏"
                    Click="OnToolbarToggle">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource ToolbarIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="TaskbarButton"
                    Width="25" Height="25" Padding="0"
                    Style="{StaticResource TitleBarButtonStyle}"
                    AutomationProperties.Name="在任务栏显示此便签"
                    ToolTip="在任务栏显示此便签"
                    Visibility="Collapsed"
                    Click="OnTaskbarToggle">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource TaskbarIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="PinButton"
                    Width="25" Height="25" Padding="0"
                    Style="{StaticResource TitleBarButtonStyle}"
                    AutomationProperties.Name="置顶"
                    ToolTip="置顶"
                    Click="OnPinToggle">
              <Path x:Name="PinIcon" Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource PinIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="CloseButton"
                    Width="25" Height="25" Padding="0"
                    Style="{StaticResource TitleBarButtonStyle}"
                    AutomationProperties.Name="关闭"
                    ToolTip="关闭"
                    ui:InteractionState.IsDanger="True"
                    Click="OnCloseClick">
              <Path Width="13" Height="13" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="EditorHost"
              Grid.Row="1"
              Background="{DynamicResource BgPrimaryBrush}"
              CornerRadius="0,0,14,14"
              Padding="8,1,8,8">
        <Grid>
          <components:MarkdownEditor x:Name="MarkdownEditor"
                                     UseBorderlessChrome="True"
                                     BlendBordersInPreview="True"
                                     HideToolbarInPreview="True"
                                     ShowNewAction="False"
                                     MinHeight="90" />
          <Grid x:Name="TimeTextHost"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,8,4"
                Background="Transparent"
                Cursor="Hand"
                ui:InteractionAnimations.Profile="Button"
                ui:InteractionAnimations.HoverScale="1.04"
                ui:InteractionAnimations.PressedScale="0.95"
                MouseLeftButtonUp="OnTimeClick">
            <TextBlock x:Name="RelativeTimeText"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="10.5"
                       Text=""
                       Opacity="1" />
            <TextBlock x:Name="FullTimeText"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="10.5"
                       Text=""
                       Opacity="0" />
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <components:MemoPopoutDockTab x:Name="DockTabLayer" Visibility="Collapsed" />
  </Grid>
</windows:BorderlessWindow>
