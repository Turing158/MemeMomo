<windows:BorderlessWindow x:Class="Memo.Views.TrayMenuWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:windows="clr-namespace:Memo.UI.Windows"
                          xmlns:ui="clr-namespace:Memo.UI"
                          Height="160"
                          ResizeMode="NoResize"
                          WindowStartupLocation="Manual"
                          ShowInTaskbar="False"
                          ShowActivated="False"
                          UseBuiltInTitleBar="False"
                          TitleBarHeight="0"
                          Topmost="True"
                          CornerRadius="12"
                          ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          Deactivated="OnDeactivated">
  <windows:BorderlessWindow.Resources>
        <Style x:Key="TrayMenuItemButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="ui:InteractionAnimations.Profile" Value="MenuItem" />
      <Setter Property="ui:InteractionAnimations.TargetName" Value="ItemContent" />
      <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="ItemHoverLayer" />
      <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="ItemPressedLayer" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ItemBackground"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="ItemHoverLayer"
                        Background="{DynamicResource BgHoverBrush}"
                        CornerRadius="5"
                        Opacity="0" />
                <Border x:Name="ItemPressedLayer"
                        Background="{DynamicResource SurfaceActiveBrush}"
                        CornerRadius="5"
                        Opacity="0" />
                <Border x:Name="ItemContent"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        RenderTransformOrigin="0.5,0.5">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsPinActive), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </windows:BorderlessWindow.Resources>
  <Grid x:Name="MenuLayout" Margin="5,6">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Button x:Name="OpenButton" Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnOpenClick" AutomationProperties.Name="打开备忘录">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MemoIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Grid.Column="1" Margin="5,0,0,0" Text="打开备忘录" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" /></Grid>
        </Button>
        <Button x:Name="NewButton" Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnNewMemoClick" AutomationProperties.Name="新建备忘录">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource SearchIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Grid.Column="1" Margin="5,0,0,0" Text="新建备忘录" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" /></Grid>
        </Button>
      </StackPanel>
      <Border Grid.Row="1" Height="1" Margin="8,5" Background="{DynamicResource BorderSubtleBrush}" />
      <StackPanel Grid.Row="2">
        <Button x:Name="PinButton" Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnPinClick" AutomationProperties.Name="窗口置顶">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path x:Name="PinIconPath" Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource PinIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path><TextBlock Grid.Column="1" Margin="5,0,0,0" Text="窗口置顶" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" /></Grid>
        </Button>
        <Button x:Name="ExitButton" Style="{StaticResource TrayMenuItemButtonStyle}" Click="OnExitClick" AutomationProperties.Name="退出应用">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /><TextBlock Grid.Column="1" Margin="5,0,0,0" Text="退出应用" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" /></Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</windows:BorderlessWindow>
