<UserControl x:Class="Memo.Components.TimeWheelSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Memo.UI">
  <UserControl.Resources>
    <Style x:Key="TimeWheelTrackStyle" TargetType="Border">
      <Setter Property="Height" Value="98" />
      <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="SizeNS" />
      <Setter Property="ui:InteractionAnimations.Profile" Value="Surface" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
        <Style x:Key="TimeWheelStepStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ui:InteractionAnimations.TargetName" Value="StepContent" />
      <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="StepHoverLayer" />
      <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="StepPressedLayer" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="StepSurface" Background="{TemplateBinding Background}" ClipToBounds="True">
              <Grid>
                <Border x:Name="StepHoverLayer" Background="{DynamicResource BgHoverBrush}" Opacity="0" />
                <Border x:Name="StepPressedLayer" Background="{DynamicResource SurfaceActiveBrush}" Opacity="0" />
                <Grid x:Name="StepContent" RenderTransformOrigin="0.5,0.5">
                  <ContentPresenter />
                </Grid>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TimeWheelLabelStyle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="14" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="98" />
    </Grid.RowDefinitions>
    <TextBlock Style="{StaticResource TimeWheelLabelStyle}" Text="时" />
    <TextBlock Grid.Column="2" Style="{StaticResource TimeWheelLabelStyle}" Text="分" />
    <TextBlock Grid.Column="4" Style="{StaticResource TimeWheelLabelStyle}" Text="秒" />

    <Border x:Name="HourTrack"
            Grid.Row="1"
            Tag="Hour"
            AutomationProperties.Name="小时"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource TimeWheelTrackStyle}"
            ToolTip="滚轮、上下拖动或方向键调整小时">
      <Grid ClipToBounds="True">
        <Border Height="32"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource AccentMutedBrush}"
                BorderThickness="0,1"
                IsHitTestVisible="False" />
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
          <Button Tag="Hour:-1" AutomationProperties.Name="上一小时" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
          <Button Grid.Row="2" Tag="Hour:1" AutomationProperties.Name="下一小时" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
        </Grid>
        <!-- Keep the translated full-height strips inside a finite viewport. -->
        <Canvas x:Name="HourNumberViewport" ClipToBounds="True" IsHitTestVisible="False">
          <StackPanel x:Name="HourPrimaryStrip" Width="{Binding ActualWidth, ElementName=HourNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
          <StackPanel x:Name="HourBufferStrip" Width="{Binding ActualWidth, ElementName=HourNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
        </Canvas>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text=":" />

    <Border x:Name="MinuteTrack"
            Grid.Row="1"
            Grid.Column="2"
            Tag="Minute"
            AutomationProperties.Name="分钟"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource TimeWheelTrackStyle}"
            ToolTip="滚轮、上下拖动或方向键调整分钟">
      <Grid ClipToBounds="True">
        <Border Height="32" VerticalAlignment="Center" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="0,1" IsHitTestVisible="False" />
        <Grid><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
          <Button Tag="Minute:-1" AutomationProperties.Name="上一分钟" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
          <Button Grid.Row="2" Tag="Minute:1" AutomationProperties.Name="下一分钟" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
        </Grid>
        <Canvas x:Name="MinuteNumberViewport" ClipToBounds="True" IsHitTestVisible="False">
          <StackPanel x:Name="MinutePrimaryStrip" Width="{Binding ActualWidth, ElementName=MinuteNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
          <StackPanel x:Name="MinuteBufferStrip" Width="{Binding ActualWidth, ElementName=MinuteNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
        </Canvas>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Text=":" />

    <Border x:Name="SecondTrack"
            Grid.Row="1"
            Grid.Column="4"
            Tag="Second"
            AutomationProperties.Name="秒钟"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            Style="{StaticResource TimeWheelTrackStyle}"
            ToolTip="滚轮、上下拖动或方向键调整秒钟">
      <Grid ClipToBounds="True">
        <Border Height="32" VerticalAlignment="Center" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="0,1" IsHitTestVisible="False" />
        <Grid><Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
          <Button Tag="Second:-1" AutomationProperties.Name="上一秒" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
          <Button Grid.Row="2" Tag="Second:1" AutomationProperties.Name="下一秒" Style="{StaticResource TimeWheelStepStyle}" Click="OnStepClick" />
        </Grid>
        <Canvas x:Name="SecondNumberViewport" ClipToBounds="True" IsHitTestVisible="False">
          <StackPanel x:Name="SecondPrimaryStrip" Width="{Binding ActualWidth, ElementName=SecondNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
          <StackPanel x:Name="SecondBufferStrip" Width="{Binding ActualWidth, ElementName=SecondNumberViewport}"><StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform></StackPanel>
        </Canvas>
      </Grid>
    </Border>
  </Grid>
</UserControl>
