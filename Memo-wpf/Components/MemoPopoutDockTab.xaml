<UserControl x:Class="Memo.Components.MemoPopoutDockTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 便签贴边 D 形标签。左右两套显式布局（不使用 ScaleX/FlowDirection 翻转，避免镜像文字）：
       边缘侧直边贴屏幕边，对侧两端角为半圆弧（半径 = TabHeight/2）。
       内容布局（左边缘）：标题（贴直边、留边距间距）→ 箭头（靠弧端，箭头外缘距弧端边 9，
       位于圆角结束线 14 与原弧端留白 4 的中间）→ 弧端把手；右边缘整体镜像。
       垂直视觉居中校正：布局上文本已 VerticalAlignment=Center，但 28 高标签内整行居中后，
       Inter/雅黑字形的墨迹实测仍偏低（重心 1.0–1.1，下部笔画更重），标题静态上移 1；
       箭头的校正随朝向由代码驱动（‹ 未旋转上移 1，旋转 180° 成 › 后渲染相位不同、改为下移 2），
       平移排在 RotateTransform 之后，避免被旋转动画连带翻转方向。
       两套布局 Grid 不设背景（null）：命中区域跟随 D 形可见边（Border 圆角命中），
       弧外透明像素点击穿透到底层窗口；若设 Transparent 会扩大命中到整个窗口矩形。 -->
  <Grid>
    <Grid x:Name="LeftLayout" MouseLeftButtonDown="OnBodyPressed">
      <Border x:Name="LeftShell"
              Background="{DynamicResource BgPrimaryBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}"
              BorderThickness="1"
              CornerRadius="0,14,14,0" />
      <Grid Margin="9,0,4,0" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LeftTitle"
                   Grid.Column="0"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   TextTrimming="None">
          <TextBlock.RenderTransform>
            <TranslateTransform Y="-1" />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="LeftArrow"
                   Grid.Column="1"
                   Text="&#x2039;"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="2,0,5,0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <TransformGroup>
              <RotateTransform x:Name="LeftArrowRotation" Angle="0" />
              <TranslateTransform x:Name="LeftArrowShift" Y="0" />
            </TransformGroup>
          </TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
      <Border x:Name="LeftHandle"
              HorizontalAlignment="Right"
              Width="14"
              Background="{DynamicResource TransparentBrush}"
              Cursor="SizeWE"
              MouseLeftButtonDown="OnHandlePressed"
              MouseEnter="OnHandleMouseEnter"
              MouseLeave="OnHandleMouseLeave" />
      <Border x:Name="LeftHandleHighlight"
              HorizontalAlignment="Right"
              Width="14"
              Margin="1,1,1,1"
              CornerRadius="0,12,12,0"
              BorderBrush="{DynamicResource AccentPrimaryBrush}"
              BorderThickness="1.5"
              Opacity="0"
              IsHitTestVisible="False" />
    </Grid>

    <Grid x:Name="RightLayout" MouseLeftButtonDown="OnBodyPressed">
      <Border x:Name="RightShell"
              Background="{DynamicResource BgPrimaryBrush}"
              BorderBrush="{DynamicResource BorderDefaultBrush}"
              BorderThickness="1"
              CornerRadius="14,0,0,14" />
      <Grid Margin="4,0,9,0" IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="RightArrow"
                   Grid.Column="0"
                   Text="&#x2039;"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="5,0,2,0"
                   RenderTransformOrigin="0.5,0.5">
          <TextBlock.RenderTransform>
            <TransformGroup>
              <RotateTransform x:Name="RightArrowRotation" Angle="0" />
              <TranslateTransform x:Name="RightArrowShift" Y="0" />
            </TransformGroup>
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="RightTitle"
                   Grid.Column="1"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   TextAlignment="Right"
                   TextTrimming="None">
          <TextBlock.RenderTransform>
            <TranslateTransform Y="-1" />
          </TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
      <Border x:Name="RightHandle"
              HorizontalAlignment="Left"
              Width="14"
              Background="{DynamicResource TransparentBrush}"
              Cursor="SizeWE"
              MouseLeftButtonDown="OnHandlePressed"
              MouseEnter="OnHandleMouseEnter"
              MouseLeave="OnHandleMouseLeave" />
      <Border x:Name="RightHandleHighlight"
              HorizontalAlignment="Left"
              Width="14"
              Margin="1,1,1,1"
              CornerRadius="12,0,0,12"
              BorderBrush="{DynamicResource AccentPrimaryBrush}"
              BorderThickness="1.5"
              Opacity="0"
              IsHitTestVisible="False" />
    </Grid>
  </Grid>
</UserControl>
