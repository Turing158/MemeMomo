<windows:BorderlessWindow x:Class="MemeMomo.Views.SettingsWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                          xmlns:windows="clr-namespace:MemeMomo.UI.Windows"
                          xmlns:components="clr-namespace:MemeMomo.Components"
                          xmlns:ui="clr-namespace:MemeMomo.UI"
                          Title="{loc:Localize '设置'}"
                          Width="380"
                          Height="430"
                          MinWidth="360"
                          MinHeight="400"
                          ResizeMode="CanResize"
                          WindowStartupLocation="CenterOwner"
                          ShowInTaskbar="False"
                          UseBuiltInTitleBar="False"
                          TitleBarHeight="0"
                          CornerRadius="14"
                          PreviewKeyDown="OnWindowPreviewKeyDown"
                          PreviewKeyUp="OnWindowPreviewKeyUp">
  <windows:BorderlessWindow.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Keep the settings panel scrollbar visually consistent with the memo editor. -->
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource EditorOverlayScrollBarStyle}" />
    <Style x:Key="SettingsCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="HotkeyButtonStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
      <Setter Property="MinWidth" Value="126" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=(ui:InteractionState.IsInvalid), RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DangerPrimaryBrush}" />
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="DescriptionStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </windows:BorderlessWindow.Resources>

  <Grid Background="{DynamicResource BgPrimaryBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
      <Grid Margin="16,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{loc:Localize '设置'}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Width="34" Height="34" Padding="0" Style="{StaticResource TitleBarButtonStyle}" ToolTip="{loc:Localize '关闭'}" AutomationProperties.Name="{loc:Localize '关闭设置'}" Click="OnCloseClick"><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16">
        <Border Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '语言'}" />
            <components:SegmentedSelector x:Name="LanguageSelector" Margin="0,10,0,0" AutomationProperties.Name="{loc:Localize '语言'}" />
          </StackPanel>
        </Border>
        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '关闭按钮操作'}" /><components:SegmentedSelector x:Name="CloseActionSelector" Margin="0,10,0,0" AutomationProperties.Name="{loc:Localize '关闭按钮操作'}" /></StackPanel></Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '功能设置'}" />
            <components:AnimatedCheckBox x:Name="QuickMemoEnabledCheckBox" Margin="0,8,0,0" Checked="OnQuickMemoEnabledChanged" Unchecked="OnQuickMemoEnabledChanged" AutomationProperties.Name="{loc:Localize '快速添加剪贴板内容'}"><StackPanel><TextBlock Text="{loc:Localize '快速添加剪贴板内容'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '通过快捷键将剪贴板内容快速添加为备忘录'}" /></StackPanel></components:AnimatedCheckBox>
            <components:CollapsibleSection x:Name="QuickMemoPopoutSection" SpacingCompensation="10"><components:AnimatedCheckBox x:Name="QuickMemoShowPopoutCheckBox" Checked="OnQuickMemoShowPopoutChanged" Unchecked="OnQuickMemoShowPopoutChanged" AutomationProperties.Name="{loc:Localize '快速添加后自动显示便签'}"><StackPanel><TextBlock Text="{loc:Localize '快速添加后自动显示便签'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '快速添加后在鼠标位置弹出便签窗口'}" /></StackPanel></components:AnimatedCheckBox></components:CollapsibleSection>
            <components:AnimatedCheckBox x:Name="DuplicateMemoCheckBox" Checked="OnDuplicateMemoChanged" Unchecked="OnDuplicateMemoChanged" AutomationProperties.Name="{loc:Localize '重复便签'}"><StackPanel><TextBlock Text="{loc:Localize '重复便签'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '关闭时移动已有窗体，开启时总是创建新窗体'}" /></StackPanel></components:AnimatedCheckBox>
            <components:AnimatedCheckBox x:Name="DockEnabledCheckBox" Checked="OnDockEnabledChanged" Unchecked="OnDockEnabledChanged" AutomationProperties.Name="{loc:Localize '启用贴边'}"><StackPanel><TextBlock Text="{loc:Localize '启用贴边'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '拖动主窗口到屏幕边缘时收起为方块'}" /></StackPanel></components:AnimatedCheckBox>
            <components:AnimatedCheckBox x:Name="PopoutDockEnabledCheckBox" Checked="OnPopoutDockEnabledChanged" Unchecked="OnPopoutDockEnabledChanged" AutomationProperties.Name="{loc:Localize '便签贴边'}"><StackPanel><TextBlock Text="{loc:Localize '便签贴边'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '拖动便签到屏幕左右边缘时收起为半圆标签'}" /></StackPanel></components:AnimatedCheckBox>
            <components:AnimatedCheckBox x:Name="ShowMainWindowTaskbarCheckBox" Checked="OnShowMainWindowTaskbarChanged" Unchecked="OnShowMainWindowTaskbarChanged" AutomationProperties.Name="{loc:Localize '显示主界面任务栏图标'}"><StackPanel><TextBlock Text="{loc:Localize '主界面任务栏图标'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '主界面显示时在 Windows 任务栏中显示图标'}" /></StackPanel></components:AnimatedCheckBox>
            <components:AnimatedCheckBox x:Name="ShowMemoWindowTaskbarCheckBox" Checked="OnShowMemoWindowTaskbarChanged" Unchecked="OnShowMemoWindowTaskbarChanged" AutomationProperties.Name="{loc:Localize '显示便签窗口任务栏图标'}"><StackPanel><TextBlock Text="{loc:Localize '便签窗口任务栏图标'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '在标题栏显示按钮，可单独控制每个便签的任务栏图标'}" /></StackPanel></components:AnimatedCheckBox>
            <components:AnimatedCheckBox x:Name="MemoWindowTopmostCheckBox" Checked="OnMemoWindowTopmostChanged" Unchecked="OnMemoWindowTopmostChanged" AutomationProperties.Name="{loc:Localize '新建便签默认置顶'}"><StackPanel><TextBlock Text="{loc:Localize '新建便签默认置顶'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '新弹出的便签窗口自动置顶，可在标题栏用图钉单独关闭'}" /></StackPanel></components:AnimatedCheckBox>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Localize '托盘图标点击习惯'}" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '设置单击还是双击托盘图标显示主界面'}" /></StackPanel><components:LabeledToggleSwitch Grid.Column="1" x:Name="TrayClickToggle" MinWidth="108" Margin="8,0,0,0" LeftLabel="{loc:Localize '单击'}" RightLabel="{loc:Localize '双击'}" VerticalAlignment="Center" /></Grid>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '提醒方式'}" />
            <TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '系统通知会遵循 Windows 的免打扰设置'}" />
            <components:SegmentedSelector x:Name="ReminderNotificationSelector" Margin="0,10,0,0" AutomationProperties.Name="{loc:Localize '提醒方式'}" />
          </StackPanel>
        </Border>

        <components:CollapsibleSection x:Name="DockSizeSection" SpacingCompensation="12">
          <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '贴边方块大小'}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '调整主窗口贴边收起后的方块尺寸'}" /><components:AnimatedSlider x:Name="DockSizeSlider" Minimum="30" Maximum="75" Step="1" ValueSuffix="px" AutomationProperties.Name="{loc:Localize '贴边方块大小'}" /></StackPanel></Border>
        </components:CollapsibleSection>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '主题颜色'}" /><components:SegmentedSelector x:Name="ThemeSelector" Margin="0,10,0,0" AutomationProperties.Name="{loc:Localize '主题颜色'}" /></StackPanel></Border>
        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '界面动效'}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '控制窗口和界面微交互动画'}" /><components:SegmentedSelector x:Name="MotionSelector" Margin="0,10,0,0" AutomationProperties.Name="{loc:Localize '界面动效'}" /><components:CollapsibleSection x:Name="MotionSystemStatusSection" SpacingCompensation="10" IsExpanded="False"><TextBlock x:Name="MotionSystemStatusText" Margin="0,10,0,0" Style="{StaticResource DescriptionStyle}" /></components:CollapsibleSection></StackPanel></Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '快捷键设置'}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '点击后按快捷键，按 Esc 留空，右键取消'}" />
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="{loc:Localize '置顶'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /><Button Grid.Column="1" x:Name="ToggleTopmostHotkeyButton" Tag="ToggleTopmost" Style="{StaticResource HotkeyButtonStyle}" Click="OnHotkeyButtonClick" PreviewMouseRightButtonDown="OnHotkeyButtonRightClick" />
              <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{loc:Localize '最小化'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /><Button Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" x:Name="MinimizeHotkeyButton" Tag="Minimize" Style="{StaticResource HotkeyButtonStyle}" Click="OnHotkeyButtonClick" PreviewMouseRightButtonDown="OnHotkeyButtonRightClick" />
              <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{loc:Localize '显示软件'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /><Button Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" x:Name="ShowWindowHotkeyButton" Tag="ShowWindow" Style="{StaticResource HotkeyButtonStyle}" Click="OnHotkeyButtonClick" PreviewMouseRightButtonDown="OnHotkeyButtonRightClick" />
              <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{loc:Localize '快速添加（剪贴板）'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /><Button Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" x:Name="QuickMemoHotkeyButton" Tag="QuickMemo" Style="{StaticResource HotkeyButtonStyle}" Click="OnHotkeyButtonClick" PreviewMouseRightButtonDown="OnHotkeyButtonRightClick" />
              <components:CollapsibleSection Grid.Row="4" Grid.ColumnSpan="2" x:Name="MemoTaskbarHotkeySection" IsExpanded="False"><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Localize '切换便签任务栏图标'}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /><Button Grid.Column="1" x:Name="ToggleMemoTaskbarHotkeyButton" Tag="ToggleMemoTaskbar" Style="{StaticResource HotkeyButtonStyle}" Click="OnHotkeyButtonClick" PreviewMouseRightButtonDown="OnHotkeyButtonRightClick" /></Grid></components:CollapsibleSection>
            </Grid>
            <components:CollapsibleSection x:Name="HotkeyValidationSection" SpacingCompensation="12" IsExpanded="False"><TextBlock x:Name="HotkeyValidationText" Margin="0,12,0,0" FontSize="11.5" Foreground="{DynamicResource DangerPrimaryBrush}" TextWrapping="Wrap" /></components:CollapsibleSection>
          </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '教程'}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '查看使用教程'}" /></StackPanel><Button Grid.Column="1" Height="34" Padding="16,0" Style="{StaticResource DialogSecondaryActionButtonStyle}" Content="{loc:Localize '教程'}" Click="OnTutorialClick" /></Grid></Border>
        <Border Margin="0,12,0,16" Style="{StaticResource SettingsCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Localize '重置设置'}" /><TextBlock Style="{StaticResource DescriptionStyle}" Text="{loc:Localize '恢复关闭行为、快捷键和其它偏好默认值'}" /></StackPanel><Button Grid.Column="1" Height="34" Padding="14,0" Style="{StaticResource DialogDangerActionButtonStyle}" Content="{loc:Localize '重置'}" Click="OnResetClick" /></Grid></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</windows:BorderlessWindow>
