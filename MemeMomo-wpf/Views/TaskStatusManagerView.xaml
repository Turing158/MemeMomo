<UserControl x:Class="MemeMomo.Views.TaskStatusManagerView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:MemeMomo.UI.Text"
 xmlns:ui="clr-namespace:MemeMomo.UI"
 xmlns:components="clr-namespace:MemeMomo.Components"
 Focusable="False" KeyboardNavigation.TabNavigation="Local"
 PreviewKeyDown="OnPreviewKeyDown">
 <UserControl.Resources>
  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource EditorOverlayScrollBarStyle}" />
  <Style x:Key="ManagerCardStyle" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="12" />
   <Setter Property="Padding" Value="14" />
  </Style>
  <Style x:Key="ManagerHeadingStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="ManagerLabelStyle" TargetType="TextBlock">
   <Setter Property="Margin" Value="0,12,0,5" />
   <Setter Property="FontSize" Value="12" />
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="ManagerDescriptionStyle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11.5" />
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <DataTemplate x:Key="ManagerChoiceTemplate">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /></Grid.ColumnDefinitions>
    <Border x:Name="Swatch" Width="14" Height="14" CornerRadius="4" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center" />
    <ui:TaskStatusIcon x:Name="ChoiceIcon" Grid.Column="1" IconKey="{Binding IconKey}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    <TextBlock Grid.Column="2" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <ui:TaskStatusIcon Grid.Column="3" IconKey="ChevronDown" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
   </Grid>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}"><Setter TargetName="Swatch" Property="Visibility" Value="Collapsed" /></DataTrigger>
    <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}"><Setter TargetName="ChoiceIcon" Property="Visibility" Value="Collapsed" /></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="ManagerChoiceStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
   <Setter Property="MinHeight" Value="40" />
   <Setter Property="Padding" Value="11,8" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}" />
   <Setter Property="ui:CornerRadiusProxy.Value" Value="9" />
   <Setter Property="ContentTemplate" Value="{StaticResource ManagerChoiceTemplate}" />
   <Setter Property="ToolTip" Value="{Binding Content.Label, RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style x:Key="StatusRowStyle" TargetType="ListBoxItem">
   <Setter Property="Margin" Value="4,2" />
   <Setter Property="Padding" Value="10,9" />
   <Setter Property="HorizontalContentAlignment" Value="Stretch" />
   <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource MemoFocusVisualStyle}" />
   <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
   <Setter Property="ToolTip" Value="{Binding Label}" />
   <Setter Property="ui:InteractionAnimations.Profile" Value="Surface" />
   <Setter Property="ui:InteractionAnimations.TargetName" Value="RowSurface" />
   <Setter Property="ui:InteractionAnimations.HoverScale" Value="1" />
   <Setter Property="ui:InteractionAnimations.PressedScale" Value="1" />
   <Setter Property="ui:InteractionAnimations.SurfaceHoverLayerName" Value="RowHoverLayer" />
   <Setter Property="ui:InteractionAnimations.SurfacePressedLayerName" Value="RowPressedLayer" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ListBoxItem">
      <Grid x:Name="RowSurface">
       <Border x:Name="RowFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" />
       <Border x:Name="RowHoverLayer" Background="{DynamicResource BgHoverBrush}" CornerRadius="9" IsHitTestVisible="False" Opacity="0" />
       <Border x:Name="RowPressedLayer" Background="{DynamicResource AccentSubtlePressedBrush}" CornerRadius="9" IsHitTestVisible="False" Opacity="0" />
       <Grid Margin="{TemplateBinding Padding}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center" />
        <ui:TaskStatusIcon x:Name="SelectedMark" Grid.Column="1" IconKey="Selection" Width="14" Height="14" Visibility="Hidden"
                           Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
       </Grid>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentMutedBrush}" />
        <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
        <Setter TargetName="RowHoverLayer" Property="Background" Value="{DynamicResource AccentSubtlePressedBrush}" />
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource BorderFocusBrush}" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <ScrollViewer x:Name="ManagerScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,8,0">
  <StackPanel Margin="16,4,16,12" MaxWidth="800">
   <Border Style="{StaticResource ManagerCardStyle}">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{loc:Localize '状态列表'}" Style="{StaticResource ManagerHeadingStyle}" VerticalAlignment="Center" />
      <Border Grid.Column="1" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="6" Padding="7,3">
       <TextBlock x:Name="StatusCountText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>
     </Grid>
     <TextBlock Text="{loc:Localize '选择状态，编辑名称、颜色和图标。'}" Style="{StaticResource ManagerDescriptionStyle}" Margin="0,5,0,10" />
     <Border CornerRadius="10" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="0,4">
      <ListBox x:Name="StatusList" Height="230" SelectionChanged="OnSelected" ItemContainerStyle="{StaticResource StatusRowStyle}"
               Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
               ScrollViewer.CanContentScroll="False" AutomationProperties.Name="{loc:Localize '状态列表'}">
       <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
         <ScrollViewer x:Name="StatusListScrollViewer" Focusable="False" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter />
         </ScrollViewer>
        </ControlTemplate>
       </ListBox.Template>
       <ListBox.ItemTemplate>
        <DataTemplate>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="9" Background="{Binding Background}" VerticalAlignment="Center">
           <ui:TaskStatusIcon IconKey="{Binding Status.IconKey}" Foreground="{Binding Color}" Width="17" Height="17" />
          </Border>
          <StackPanel Grid.Column="1" Margin="7,0,0,0">
           <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
           <Grid Margin="0,3,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{loc:Localize '已隐藏'}" Margin="8,0,0,0" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}">
             <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Status.IsHidden}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
           </Grid>
          </StackPanel>
         </Grid>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Border>
     <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="NewButton" Content="{loc:Localize '新增状态'}" Style="{StaticResource DialogSecondaryActionButtonStyle}" HorizontalAlignment="Left" Click="OnNew" />
      <Button x:Name="MoveUpButton" Grid.Column="1" Style="{StaticResource DialogIconButtonStyle}" ToolTip="{loc:Localize '上移'}" AutomationProperties.Name="{loc:Localize '上移'}" Click="OnMoveUp">
       <ui:TaskStatusIcon IconKey="ChevronDown" Width="16" Height="16" RenderTransformOrigin="0.5,0.5"><ui:TaskStatusIcon.RenderTransform><RotateTransform Angle="180" /></ui:TaskStatusIcon.RenderTransform></ui:TaskStatusIcon>
      </Button>
      <Button x:Name="MoveDownButton" Grid.Column="2" Margin="5,0,0,0" Style="{StaticResource DialogIconButtonStyle}" ToolTip="{loc:Localize '下移'}" AutomationProperties.Name="{loc:Localize '下移'}" Click="OnMoveDown">
       <ui:TaskStatusIcon IconKey="ChevronDown" Width="16" Height="16" />
      </Button>
     </Grid>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource ManagerCardStyle}" Margin="0,12,0,0">
    <StackPanel>
     <TextBlock Text="{loc:Localize '状态详情'}" Style="{StaticResource ManagerHeadingStyle}" />
     <TextBlock x:Name="BuiltInHint" Text="{loc:Localize '内置状态的名称和类别不能修改。'}" Style="{StaticResource ManagerDescriptionStyle}" Margin="0,5,0,0" />
     <TextBlock Text="{loc:Localize '状态名称'}" Style="{StaticResource ManagerLabelStyle}" />
     <Border Style="{StaticResource DialogInputRootStyle}">
      <TextBox x:Name="NameBox" Margin="11,0" Style="{StaticResource DialogTextBoxStyle}" TextChanged="OnNameChanged" AutomationProperties.Name="{loc:Localize '状态名称'}" />
     </Border>
     <TextBlock Text="{loc:Localize '基础类别'}" Style="{StaticResource ManagerLabelStyle}" />
     <Button x:Name="CategoryBox" Style="{StaticResource ManagerChoiceStyle}" Click="OnOpenChoiceMenu" AutomationProperties.Name="{loc:Localize '基础类别'}" />
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{loc:Localize '颜色'}" Style="{StaticResource ManagerLabelStyle}" />
       <Button x:Name="ColorBox" Style="{StaticResource ManagerChoiceStyle}" Click="OnOpenChoiceMenu" AutomationProperties.Name="{loc:Localize '颜色'}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="{loc:Localize '图标'}" Style="{StaticResource ManagerLabelStyle}" />
       <Button x:Name="IconBox" Style="{StaticResource ManagerChoiceStyle}" Click="OnOpenChoiceMenu" AutomationProperties.Name="{loc:Localize '图标'}" />
      </StackPanel>
     </Grid>
     <Border x:Name="PreviewBadge" CornerRadius="9" Padding="10,9" Margin="0,12,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <ui:TaskStatusIcon x:Name="PreviewIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
       <TextBlock x:Name="PreviewText" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Grid>
     </Border>
     <components:AnimatedCheckBox x:Name="HiddenCheck" Margin="0,7,0,9" AutomationProperties.Name="{loc:Localize '隐藏此状态（已有任务仍显示）'}">
      <TextBlock Text="{loc:Localize '隐藏此状态（已有任务仍显示）'}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
     </components:AnimatedCheckBox>
     <Button x:Name="SaveButton" Content="{loc:Localize '保存状态'}" Style="{StaticResource DialogPrimaryActionButtonStyle}" Click="OnSave" />
    </StackPanel>
   </Border>
   <Border x:Name="MigrationCard" Style="{StaticResource ManagerCardStyle}" Margin="0,12,0,0">
    <StackPanel>
     <TextBlock Text="{loc:Localize '删除与迁移'}" Style="{StaticResource ManagerHeadingStyle}" />
     <TextBlock x:Name="ImpactText" Margin="0,8,0,0" Style="{StaticResource ManagerDescriptionStyle}" />
     <TextBlock Text="{loc:Localize '删除时迁移到'}" Style="{StaticResource ManagerLabelStyle}" />
     <Button x:Name="ReplacementBox" Style="{StaticResource ManagerChoiceStyle}" Click="OnOpenChoiceMenu" AutomationProperties.Name="{loc:Localize '删除时迁移到'}" />
     <Button x:Name="DeleteButton" Content="{loc:Localize '删除状态并迁移任务'}" Style="{StaticResource DialogDangerActionButtonStyle}" Margin="0,12,0,0" Click="OnDelete" />
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
