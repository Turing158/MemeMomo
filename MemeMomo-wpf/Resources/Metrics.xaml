<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <sys:TimeSpan x:Key="MotionFastDuration">0:0:0.15</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionStandardDuration">0:0:0.19</sys:TimeSpan>
  <sys:TimeSpan x:Key="MotionDockDuration">0:0:0.22</sys:TimeSpan>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>
  <CornerRadius x:Key="RadiusXl">20</CornerRadius>
  <CornerRadius x:Key="RadiusFull">999</CornerRadius>
  <FontFamily x:Key="AppFontFamily">Inter, Microsoft YaHei, Microsoft YaHei UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
  <BooleanToVisibilityConverter x:Key="BooleanToCollapsedVisibilityConverter" />
</ResourceDictionary>
