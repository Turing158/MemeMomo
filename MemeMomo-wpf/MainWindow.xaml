<windows:BorderlessWindow x:Class="MemeMomo.MainWindow"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                          xmlns:windows="clr-namespace:MemeMomo.UI.Windows"
                          xmlns:ui="clr-namespace:MemeMomo.UI"
                          xmlns:layout="clr-namespace:MemeMomo.UI.Layout"
                          xmlns:models="clr-namespace:MemeMomo.Models"
                          xmlns:components="clr-namespace:MemeMomo.Components"
                          Title="MemeMomo"
                          Width="420"
                          Height="680"
                          MinWidth="360"
                          MinHeight="480"
                          WindowStartupLocation="CenterScreen"
                          ShowInTaskbar="False"
                          UseBuiltInTitleBar="False"
                          ResizeMode="CanResize"
                          CornerRadius="14"
                          TitleBarHeight="49"
                          Background="Transparent"
                          PreviewKeyDown="OnWindowPreviewKeyDown"
                          PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp">
  <windows:BorderlessWindow.Resources>
    <ui:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />
    <ui:PositiveCountToVisibilityConverter x:Key="PositiveCountVisibility" />
    <ui:EmptyStringToVisibilityConverter x:Key="EmptyStringVisibility" />
    <DataTemplate x:Key="MemoItemTemplate" DataType="{x:Type models:MemoItem}">
      <Border x:Name="MemoCard"
              Style="{StaticResource MemoCardStyle}"
              Margin="0,0,0,10"
              Padding="0"
              Focusable="True"
              MouseRightButtonUp="OnMemoCardMouseRightButtonUp"
              PreviewKeyDown="OnMemoCardPreviewKeyDown"
              MouseEnter="OnMemoCardMouseEnter"
              MouseLeave="OnMemoCardMouseLeave"
              PreviewMouseLeftButtonDown="OnMemoCardPreviewMouseLeftButtonDown">
        <Grid>
          <Grid x:Name="MemoCardMotionSurface">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    x:Name="AccentBar"
                    Width="3"
                    Margin="0,10,0,10"
                    CornerRadius="2"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    Opacity="0.5" />
            <Button x:Name="RestoreButton" Grid.Column="1" Visibility="Collapsed" Margin="7,0,0,0" Padding="5"
                    VerticalAlignment="Center" Click="OnRestoreClick" ToolTip="{loc:Localize '恢复'}" AutomationProperties.Name="{loc:Localize '恢复'}">
              <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource RestoreIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Grid Grid.Column="2" Margin="13,14,8,14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid x:Name="MemoTitleRow" Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="MemoTitle" Grid.Column="0"
                           Text="{Binding Title}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,8,0" />
                <Grid x:Name="MemoActions" Grid.Column="1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <components:MemoTaskStatusSelector x:Name="CardTaskSelector" Grid.Column="0" Memo="{Binding}" CompactNote="True" CardPresentation="True" MaxWidth="145" Margin="0,0,4,0"
                    Service="{Binding DataContext.Tasks, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                <Button x:Name="DeleteButton"
                        Grid.Column="1" HorizontalAlignment="Right"
                        Style="{StaticResource DeleteButtonStyle}"
                        Click="OnDeleteClick"
                        PreviewMouseLeftButtonDown="OnDeleteButtonPreviewMouseLeftButtonDown">
                  <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource DeleteXIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                </Grid>
              </Grid>
              <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Subtitle}"
                           Visibility="{Binding Subtitle, Converter={StaticResource EmptyStringVisibility}}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RelativeTime}" ToolTip="{Binding FullTime}"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="10,0,0,0" />
              </Grid>
            </Grid>
          </Grid>
          <Border x:Name="MemoCardBorderLayer" Style="{StaticResource MemoCardBorderLayerStyle}" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsDeleted}" Value="False">
          <Setter TargetName="DeleteButton" Property="ToolTip" Value="{loc:Localize '删除'}"/>
          <Setter TargetName="DeleteButton" Property="AutomationProperties.Name" Value="{loc:Localize '删除备忘录'}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
          <Setter TargetName="CardTaskSelector" Property="CardPresentation" Value="False"/>
          <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
          <Setter TargetName="DeleteButton" Property="ToolTip" Value="{loc:Localize '彻底删除'}"/>
          <Setter TargetName="DeleteButton" Property="AutomationProperties.Name" Value="{loc:Localize '彻底删除'}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsLifecyclePending}" Value="True">
          <Setter TargetName="RestoreButton" Property="IsEnabled" Value="False"/>
          <Setter TargetName="DeleteButton" Property="IsEnabled" Value="False"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsTaskClosed}" Value="True"><Setter TargetName="MemoTitle" Property="Opacity" Value="0.65" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </windows:BorderlessWindow.Resources>

  <!-- Keep the window host transparent so the dock handle is the only visible
       surface while the native dock region is active. ExpandedSurface owns the
       normal window backgrounds. -->
  <Grid x:Name="WindowRoot" Background="Transparent">
    <Grid x:Name="ExpandedSurface" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Grid.RenderTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="49" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="TitleBar"
              Grid.Row="0"
              Background="{DynamicResource SurfacePrimaryBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="0,0,0,1"
              CornerRadius="0"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <components:ListPaneToggleButton x:Name="ListPaneToggle" Margin="-5,0,-5,0" Click="OnListPaneToggleClick" />
            <TextBlock Margin="10,0,0,0" Text="MemeMomo" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <components:HeaderFilterBadge x:Name="FilterBadge" Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center" Click="OnFilterBadgeClick" />
          <StackPanel x:Name="WindowControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SettingsButton" Click="OnSettingsClick">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                  <Setter Property="AutomationProperties.Name" Value="{loc:Localize '设置'}" />
                  <Setter Property="ToolTip" Value="{loc:Localize '设置'}" />
                  <Style.Triggers>
                    <Trigger Property="ui:InteractionState.IsPinActive" Value="True">
                      <Setter Property="AutomationProperties.Name" Value="{loc:Localize '返回上一页'}" />
                      <Setter Property="ToolTip" Value="{loc:Localize '返回上一页'}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource SettingsIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="{loc:Localize '置顶'}" ToolTip="{loc:Localize '置顶'}" Click="OnPinClick">
              <Path x:Name="PinIcon" Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource PinIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="{loc:Localize '最小化'}" ToolTip="{loc:Localize '最小化'}" Click="OnMinimizeClick">
              <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MinimizeIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="{loc:Localize '关闭'}" ToolTip="{loc:Localize '关闭'}" Click="OnCloseClick" ui:InteractionState.IsDanger="True">
              <Path Width="16" Height="16" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource BgPrimaryBrush}" CornerRadius="0">
      <Grid x:Name="PageViewport" Background="{DynamicResource BgPrimaryBrush}" ClipToBounds="True">
      <Grid x:Name="PageSurface">
      <Grid x:Name="PageContent" Margin="16,14,16,12" KeyboardNavigation.TabNavigation="Local">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <components:MarkdownEditor x:Name="MarkdownEditor"
                                   MinHeight="110"
                                   MaxHeight="230"
                                   Margin="0,0,0,10"
                                   BlendBordersInPreview="True"
                                   ShowNewAction="True">
          <components:MarkdownEditor.ToolbarLeadingContent>
            <components:MemoTaskStatusSelector Service="{Binding Tasks}" VerticalAlignment="Center" MaxWidth="128" Margin="0,0,4,0"/>
          </components:MarkdownEditor.ToolbarLeadingContent>
        </components:MarkdownEditor>
        <layout:PaneViewport x:Name="ListPaneViewport" Grid.Row="1" ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
        <Grid x:Name="ListPane" KeyboardNavigation.TabNavigation="Local">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="RecycleListTools" Height="44" Margin="0,0,0,6" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="ReturnMemosButton" Width="32" Height="32" Padding="0" Style="{StaticResource TitleBarButtonStyle}" FocusVisualStyle="{StaticResource MemoFocusVisualStyle}" Click="OnReturnMemosClick" ToolTip="{loc:Localize '返回备忘录'}" AutomationProperties.Name="{loc:Localize '返回备忘录'}">
                <ui:TaskStatusIcon Width="20" Height="20" IconKey="Back" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </Button>
              <TextBlock x:Name="RecycleTitle" Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <components:RecycleBinClearButton x:Name="ClearRecycleBinButton" Grid.Column="2"
                                               Label="{loc:Localize '全部清空'}" Click="OnClearRecycleBinClick" />
            </Grid>
          <Grid Grid.Row="1">
            <StackPanel x:Name="NoFilterResults" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8,25">
              <TextBlock Text="{loc:Localize '没有符合条件的备忘录'}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <Button Content="{loc:Localize '清除筛选'}" Click="OnClearFilters" Margin="0,10,0,0"/>
            </StackPanel>
            <Border x:Name="NormalEmptyState" Style="{StaticResource EmptyStateCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Padding="20,16"
                    Margin="16,20">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center">
                  <Path Width="24" Height="24" Stretch="Uniform" Data="{DynamicResource ChevronDownIcon}" Fill="{DynamicResource AccentMutedBrush}" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="EmptyHintArrow" Angle="180"/></Path.RenderTransform>
                  </Path>
                </Border>
                <TextBlock Margin="0,12,0,0" Text="{loc:Localize '还没有备忘录'}" Style="{StaticResource EmptyHintTitleStyle}" />
                <TextBlock x:Name="NormalEmptyHint" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Localize '在上方写下第一条 Markdown 备忘录&#x0a;按 Ctrl+Enter 新增'}" Style="{StaticResource EmptyHintSubtitleStyle}" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="RecycleEmptyState" Text="{loc:Localize '回收站为空'}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,40" Style="{StaticResource EmptyHintTitleStyle}"/>
            <ScrollViewer x:Name="MemoScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="OnMemoScrollViewerScrollChanged">
              <ItemsControl x:Name="MemoList" ItemsSource="{Binding TaskView.Items}" ItemTemplate="{StaticResource MemoItemTemplate}" Padding="6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <!-- Drag preview needs every card realized so insertion stays
                         deterministic while the list auto-scrolls. -->
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <ScrollBar x:Name="MemoOverlayScrollBar"
                       Panel.ZIndex="25"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Orientation="Vertical"
                       Style="{StaticResource EditorOverlayScrollBarStyle}"
                       Visibility="Collapsed"
                       ValueChanged="OnMemoOverlayScrollBarValueChanged"
                       PreviewMouseLeftButtonDown="OnMemoOverlayScrollBarPreviewMouseLeftButtonDown"
                       PreviewMouseLeftButtonUp="OnMemoOverlayScrollBarPreviewMouseLeftButtonUp"
                       LostMouseCapture="OnMemoOverlayScrollBarLostMouseCapture"
                       Loaded="OnMemoOverlayScrollBarLoaded" />
            <Canvas x:Name="DeleteOverlay" IsHitTestVisible="False" Panel.ZIndex="20" ClipToBounds="True" />
          </Grid>
        </Grid>
        </layout:PaneViewport>
      </Grid>
        <Canvas IsHitTestVisible="False" Focusable="False" Panel.ZIndex="29">
          <Image x:Name="LayoutTransitionSnapshot" Visibility="Collapsed" IsHitTestVisible="False"
                 Focusable="False" Stretch="None" />
        </Canvas>
        <ContentControl x:Name="SettingsHost" Visibility="Collapsed" Focusable="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Panel.ZIndex="30" />
      </Grid>
        <Image x:Name="PageTransitionSnapshot" Visibility="Collapsed" IsHitTestVisible="False"
               Focusable="False" Stretch="Fill" Panel.ZIndex="30" />
      </Grid>
      </Border>
      <components:NotificationHost x:Name="Notifications" Grid.RowSpan="2" Panel.ZIndex="40"/>
    </Grid>

    <Grid x:Name="DockLayer"
          Panel.ZIndex="50"
          Opacity="0"
          IsHitTestVisible="False"
          ToolTip="{loc:Localize '按住拖动可沿屏幕边缘移动；向内拖动可恢复窗口'}"
          AutomationProperties.Name="{loc:Localize '贴边窗口拖动手柄'}"
          ClipToBounds="True"
          MouseLeftButtonDown="OnDockMouseLeftButtonDown"
          MouseRightButtonDown="OnDockMouseRightButtonDown"
          MouseRightButtonUp="OnDockMouseRightButtonUp">
      <Grid x:Name="DockVisual"
            Width="44"
            Height="44"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            RenderTransformOrigin="0.5,0.5"
            IsHitTestVisible="False">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
        </Grid.RenderTransform>
        <Path x:Name="DockShape"
              Fill="{DynamicResource SurfacePrimaryBrush}"
              Stretch="Fill"
              IsHitTestVisible="False" />
        <Path x:Name="DockOutline"
              Fill="Transparent"
              Stroke="{DynamicResource BorderSubtleBrush}"
              StrokeThickness="1"
              Opacity="0.55"
              Stretch="Fill"
              IsHitTestVisible="False" />
        <Border x:Name="DockIconSurface"
                Width="44"
                Height="44"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                IsHitTestVisible="False">
          <Image Width="24" Height="24" Source="/MemeMomo;component/Assets/appicon.png" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <Border x:Name="DockContent"
              Width="44"
              Height="44"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Background="Transparent" />
    </Grid>
  </Grid>
</windows:BorderlessWindow>
