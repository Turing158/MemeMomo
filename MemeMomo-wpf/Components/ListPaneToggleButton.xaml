<Button x:Class="MemeMomo.Components.ListPaneToggleButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource TitleBarButtonStyle}"
        Width="32" Height="32" Padding="0" Opacity="1"
        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
        IsEnabled="False" IsHitTestVisible="False" IsTabStop="False" Focusable="False">
  <Grid Width="22" Height="22" IsHitTestVisible="False">
    <Image x:Name="AppIcon" Source="/MemeMomo;component/Assets/appicon.png"
           RenderTransformOrigin="0.5,0.5">
      <Image.RenderTransform><ScaleTransform /></Image.RenderTransform>
    </Image>
    <Path x:Name="CollapseIcon" Data="{DynamicResource CollapseListPaneIcon}" Stretch="Uniform"
          Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><ScaleTransform ScaleX="0.76" ScaleY="0.76" /></Path.RenderTransform>
    </Path>
    <Path x:Name="ExpandIcon" Data="{DynamicResource ExpandListPaneIcon}" Stretch="Uniform"
          Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
          Opacity="0" RenderTransformOrigin="0.5,0.5">
      <Path.RenderTransform><ScaleTransform ScaleX="0.76" ScaleY="0.76" /></Path.RenderTransform>
    </Path>
  </Grid>
</Button>
