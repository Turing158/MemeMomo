<UserControl x:Class="MemeMomo.Components.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MemeMomo.UI.Text"
             xmlns:ui="clr-namespace:MemeMomo.UI"
             Focusable="False" RenderTransformOrigin="0.5,0">
  <UserControl.Resources>
    <Style x:Key="NotificationDismissStyle" TargetType="Button" BasedOn="{StaticResource MemoBaseButtonStyle}">
      <Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="MinHeight" Value="52"/>
      <Setter Property="ui:CornerRadiusProxy.Value" Value="12"/>
      <Setter Property="ui:InteractionAnimations.HoverBackground" Value="{DynamicResource SurfaceHoverBrush}"/>
      <Setter Property="ui:InteractionAnimations.PressedBackground" Value="{DynamicResource SurfaceActiveBrush}"/>
      <Setter Property="ui:InteractionAnimations.HoverScale" Value="1"/>
      <Setter Property="ui:InteractionAnimations.PressedScale" Value="0.99"/>
      <Setter Property="ui:InteractionAnimations.HoverOffsetY" Value="0"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Border x:Name="PromptSurface" Visibility="Collapsed" Padding="14,12" CornerRadius="12"
            Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="PromptText" FontSize="12" LineHeight="18" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Assertive"/>
        <WrapPanel x:Name="PromptActions" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <Button x:Name="DismissButton" Style="{StaticResource NotificationDismissStyle}" Click="OnDismissClick"
            ToolTip="{loc:Localize '收起提示'}" AutomationProperties.LiveSetting="Polite">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LeadingGutter" Width="34"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="TrailingGutter" Width="34"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="KindBadge" Width="24" Height="24" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Path x:Name="KindIcon" Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Border>
        <TextBlock x:Name="MessageText" Grid.Column="1" FontSize="12" LineHeight="18" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
    </Button>
    <Button x:Name="ActionButton" Click="OnActionClick" HorizontalAlignment="Right" VerticalAlignment="Center"
            Margin="0,8,12,8" MinHeight="32" Padding="9,5" FontSize="12" Cursor="Hand" Visibility="Collapsed"/>
  </Grid>
</UserControl>
