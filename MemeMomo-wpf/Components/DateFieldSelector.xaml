<UserControl x:Class="MemeMomo.Components.DateFieldSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:MemeMomo.UI.Text"
             xmlns:popup="clr-namespace:MemeMomo.UI.Popup"
             xmlns:ui="clr-namespace:MemeMomo.UI"
             Background="{DynamicResource TransparentBrush}"
             Focusable="False">
  <Grid>
    <Border x:Name="Field"
            Height="42"
            Padding="12,0"
            Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Focusable="True"
            FocusVisualStyle="{DynamicResource MemoFocusVisualStyle}"
            ui:InteractionAnimations.Profile="Surface">
      <Grid>
        <TextBlock x:Name="FieldText"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Path x:Name="FieldChevron"
              Width="16"
              Height="16"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Data="{DynamicResource ChevronDownIcon}"
              Fill="{DynamicResource IconDefaultBrush}"
              Stretch="Uniform"
              RenderTransformOrigin="0.5,0.5">
          <Path.RenderTransform>
            <RotateTransform x:Name="FieldChevronRotation" Angle="0" />
          </Path.RenderTransform>
        </Path>
      </Grid>
    </Border>

    <Popup x:Name="CalendarPopup"
           AllowsTransparency="True"
           HorizontalOffset="0"
           Placement="Bottom"
           PlacementTarget="{Binding ElementName=Field}"
           VerticalOffset="6"
           popup:PopupAnimations.IsEnabled="True">
      <Border x:Name="CalendarSurface"
              MinWidth="288"
              Padding="8"
              Background="{DynamicResource SurfacePrimaryBrush}"
              BorderBrush="{DynamicResource BorderEmphasisBrush}"
              BorderThickness="1"
              CornerRadius="12">
        <StackPanel>
          <Grid Margin="2,0,2,6">
            <Button x:Name="PreviousMonthButton"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{loc:Localize '上一月'}"
                    Style="{DynamicResource CalendarNavigationButtonStyle}">
              <!-- 复用 ChevronDownIcon 旋转成左右箭头，不新增图标键。 -->
              <Path Width="16"
                    Height="16"
                    Data="{DynamicResource ChevronDownIcon}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Stretch="Uniform"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="90" />
                </Path.RenderTransform>
              </Path>
            </Button>
            <Button x:Name="HeaderButton"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{loc:Localize '切换到月份选择'}"
                    Style="{DynamicResource CalendarHeaderButtonStyle}">
              <TextBlock x:Name="MonthHeader"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <Button x:Name="NextMonthButton"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{loc:Localize '下一月'}"
                    Style="{DynamicResource CalendarNavigationButtonStyle}">
              <Path Width="16"
                    Height="16"
                    Data="{DynamicResource ChevronDownIcon}"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Stretch="Uniform"
                    RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                  <RotateTransform Angle="-90" />
                </Path.RenderTransform>
              </Path>
            </Button>
          </Grid>

          <!-- 日 / 月 / 年三个视图叠放在同一格。非活动视图用 Hidden 而非 Collapsed：
               Hidden 仍参与测量，浮层高度取三者最大值，切换层级时高度不跳动。 -->
          <Grid x:Name="ViewHost">
            <StackPanel x:Name="DayView" RenderTransformOrigin="0.5,0.5">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="DayViewOffset" X="0" Y="0" />
              </StackPanel.RenderTransform>
              <Grid x:Name="WeekdayHeaderGrid" Margin="0,0,0,2" />
              <Grid x:Name="MonthGrid" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <TranslateTransform x:Name="MonthGridOffset" X="0" Y="0" />
                </Grid.RenderTransform>
              </Grid>
            </StackPanel>

            <Grid x:Name="MonthPickerGrid"
                  VerticalAlignment="Center"
                  Visibility="Hidden"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="MonthPickerOffset" X="0" Y="0" />
              </Grid.RenderTransform>
            </Grid>

            <Grid x:Name="YearPickerGrid"
                  VerticalAlignment="Center"
                  Visibility="Hidden"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="YearPickerOffset" X="0" Y="0" />
              </Grid.RenderTransform>
            </Grid>
          </Grid>

          <Button x:Name="TodayButton"
                  Margin="2,6,2,0"
                  Height="32"
                  Content="{loc:Localize '今天'}"
                  AutomationProperties.Name="{loc:Localize '选择今天'}"
                  Style="{DynamicResource DialogSecondaryActionButtonStyle}" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
