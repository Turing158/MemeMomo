<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.CloseActionDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:components="clr-namespace:MemeMomo.Components"
                          xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                          xmlns:ui="clr-namespace:MemeMomo.UI"
                          Title="关闭按钮操作"
                          Width="330"
                          Height="230"
                          ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <StackPanel Margin="0,0,0,12" MouseLeftButtonDown="OnTitleBarMouseDown">
        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="关闭按钮操作" />
        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="点击右上角关闭按钮时，要最小化到托盘还是直接关闭应用？" />
      </StackPanel>
      <components:SegmentedSelector x:Name="CloseActionSelector" AutomationProperties.Name="关闭按钮操作" />
    </StackPanel>
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button Height="32" Padding="14,0" Content="取消" ui:CornerRadiusProxy.Value="8" Click="OnCancelClick" />
      <Button Height="32" Margin="8,0,0,0" Padding="14,0" Background="{DynamicResource AccentPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextOnAccentBrush}" Content="确认" ui:CornerRadiusProxy.Value="8" Click="OnConfirmClick" />
    </StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
