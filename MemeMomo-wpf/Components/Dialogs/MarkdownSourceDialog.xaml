<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.MarkdownSourceDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                          xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                          xmlns:sys="clr-namespace:System;assembly=mscorlib"
                          Title="{loc:Localize '编辑 Markdown 源码'}"
                          Width="680"
                          Height="520"
                          MinWidth="460"
                          MinHeight="340"
                          ResizeMode="CanResize"
                          ShellBackground="{DynamicResource BgPrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="20,10,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="28" Height="28" VerticalAlignment="Center" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="7"><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MemeMomoIcon}" Fill="{DynamicResource AccentPrimaryBrush}" /></Border>
      <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{loc:Localize '编辑 Markdown 源码'}" TextTrimming="CharacterEllipsis" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <TextBlock x:Name="DocumentStatsText" Grid.Column="2" Margin="12,0,12,0" VerticalAlignment="Center" Text="{loc:Localize '1 行 · 0 字符'}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
      <Button Grid.Column="3" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="{loc:Localize '关闭源码编辑面板'}" ToolTip="{loc:Localize '关闭'}" Click="OnCancelClick"><Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />
    <Border Grid.Row="2" Height="{x:Static sys:Double.NaN}" MinHeight="160" Margin="0,16,0,16" Style="{StaticResource DialogInputRootStyle}" ClipToBounds="True">
      <TextBox x:Name="SourceBox" AcceptsReturn="True" TextWrapping="NoWrap" Padding="14,12" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" VerticalContentAlignment="Top" AutomationProperties.Name="{loc:Localize 'Markdown 源码'}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="OnSourceTextChanged" />
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Margin="0,0,9,0" Content="{loc:Localize '取消'}" Style="{StaticResource DialogSecondaryActionButtonStyle}" AutomationProperties.Name="{loc:Localize '取消'}" Click="OnCancelClick" /><Button x:Name="ApplyButton" Content="{loc:Localize '应用'}" Style="{StaticResource DialogPrimaryActionButtonStyle}" AutomationProperties.Name="{loc:Localize '应用'}" Click="OnApplyClick" /></StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
