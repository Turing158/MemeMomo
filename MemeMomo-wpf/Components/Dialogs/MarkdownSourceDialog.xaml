<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.MarkdownSourceDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                          xmlns:sys="clr-namespace:System;assembly=mscorlib"
                          Title="编辑 Markdown 源码"
                          Width="680"
                          Height="520"
                          MinWidth="460"
                          MinHeight="340"
                          ResizeMode="CanResize"
                          ShellBackground="{DynamicResource BgPrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="9"><Path Width="18" Height="18" Stretch="Uniform" Data="{DynamicResource MemeMomoIcon}" Fill="{DynamicResource AccentPrimaryBrush}" /></Border>
      <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="编辑 Markdown 源码" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Margin="0,3,0,0" Text="应用后将替换当前编辑内容" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel>
      <Button Grid.Column="2" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="关闭源码编辑面板" ToolTip="关闭" Click="OnCancelClick"><Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />
    <Border Grid.Row="2" Height="{x:Static sys:Double.NaN}" MinHeight="160" Margin="0,16,0,16" Style="{StaticResource DialogInputRootStyle}" ClipToBounds="True">
      <Grid><Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Grid.Row="0" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Height="22" MinWidth="32" Padding="7,0" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="6"><TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" /></Border><TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" Text="Markdown 源码" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock x:Name="DocumentStatsText" Grid.Column="2" Margin="12,0,2,0" VerticalAlignment="Center" Text="1 行 · 0 字符" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" /></Grid><Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" /><TextBox x:Name="SourceBox" Grid.Row="2" AcceptsReturn="True" TextWrapping="NoWrap" Padding="14,12" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource TransparentBrush}" BorderThickness="0" VerticalContentAlignment="Top" AutomationProperties.Name="Markdown 源码" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" TextChanged="OnSourceTextChanged" /></Grid>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Margin="0,0,9,0" Content="取消" Style="{StaticResource DialogSecondaryActionButtonStyle}" AutomationProperties.Name="取消" Click="OnCancelClick" /><Button x:Name="ApplyButton" Content="应用" Style="{StaticResource DialogPrimaryActionButtonStyle}" AutomationProperties.Name="应用" Click="OnApplyClick" /></StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
