<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.ImageUrlDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                          xmlns:ui="clr-namespace:MemeMomo.UI"
                          Title="插入网络图片"
                          Width="460"
                          Height="260"
                          MinWidth="380"
                          MinHeight="260"
                          ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
      <RowDefinition Height="1" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="34" Height="34" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="8">
        <Path Width="17" Height="17" Stretch="Uniform" Data="{DynamicResource MdRemoteImageIcon}" Fill="{DynamicResource AccentPrimaryBrush}" />
      </Border>
      <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="插入网络图片" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Margin="0,3,0,0" Text="使用 HTTPS 地址插入图片" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
      <Button Grid.Column="2" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="关闭网络图片面板" ToolTip="关闭" Click="OnCancelClick">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />

    <StackPanel Grid.Row="2" Margin="0,16,0,14">
      <Grid Margin="0,0,0,6"><TextBlock Text="图片地址" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock HorizontalAlignment="Right" Text="必填" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" /></Grid>
      <Border x:Name="UrlInputRoot" Style="{StaticResource DialogInputRootStyle}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" CornerRadius="8,0,0,8">
            <Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MdLinkIcon}" Fill="{DynamicResource AccentPrimaryBrush}" />
          </Border>
          <TextBox x:Name="UrlBox" Grid.Column="1" Margin="11,0,4,0" Style="{StaticResource DialogTextBoxStyle}" ToolTip="https://example.com/image.png" AutomationProperties.Name="网络图片地址" TextChanged="OnUrlTextChanged" />
          <Button x:Name="ClearUrlButton" Grid.Column="2" Width="30" Height="30" Margin="0,0,4,0" Style="{StaticResource DialogInputIconButtonStyle}" AutomationProperties.Name="清空图片地址" ToolTip="清空" Visibility="Collapsed" Click="OnClearUrlClick">
            <Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </Grid>
      </Border>
      <Grid Height="22" Margin="0,5,0,0">
        <TextBlock x:Name="HelperText" VerticalAlignment="Center" Text="仅支持 HTTPS 安全地址" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
        <TextBlock x:Name="ErrorText" VerticalAlignment="Center" Text="请输入有效的 HTTPS 图片地址" FontSize="11.5" Foreground="{DynamicResource DangerPrimaryBrush}" Opacity="0" AutomationProperties.Name="图片地址错误" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="3" Background="{DynamicResource BorderSubtleBrush}" />

    <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Margin="0,0,9,0" Content="取消" Style="{StaticResource DialogSecondaryActionButtonStyle}" AutomationProperties.Name="取消" Click="OnCancelClick" />
      <Button x:Name="SubmitButton" Content="插入图片" Style="{StaticResource DialogPrimaryActionButtonStyle}" AutomationProperties.Name="插入图片" Click="OnSubmitClick" />
    </StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
