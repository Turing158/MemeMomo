<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.ImageEditDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                         xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                         Title="{loc:Localize '编辑图片'}" Width="580" Height="484"
                         ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                         ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                         PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="22,18,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="1" />
      <RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14" MouseLeftButtonDown="OnTitleMouseDown">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{loc:Localize '编辑图片'}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Margin="0,5,0,0" Text="{loc:Localize '源码与下方字段同步，保留图片结构'}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="{loc:Localize '关闭'}" ToolTip="{loc:Localize '关闭'}" Click="OnCancelClick">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />
    <Grid Grid.Row="2" Margin="0,16,0,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="14" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{loc:Localize '图片源码'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border x:Name="SourceInputRoot" Grid.Row="1" Height="Auto" Margin="0,5,0,0" Style="{StaticResource DialogInputRootStyle}">
        <TextBox x:Name="SourceBox" AcceptsReturn="True" TextWrapping="Wrap" Padding="11,9"
                 Style="{StaticResource DialogTextBoxStyle}" VerticalContentAlignment="Top"
                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="13"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Localize '图片源码'}"
                 TextChanged="OnSourceTextChanged" />
      </Border>
      <TextBlock Grid.Row="3" Text="{loc:Localize '替代文本（alt）'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border Grid.Row="4" Margin="0,5,0,14" Style="{StaticResource DialogInputRootStyle}">
        <TextBox x:Name="AltBox" Margin="11,0" Style="{StaticResource DialogTextBoxStyle}" AutomationProperties.Name="{loc:Localize '替代文本（alt）'}" TextChanged="OnFieldTextChanged" />
      </Border>
      <TextBlock Grid.Row="5" Text="{loc:Localize '链接或路径（src）'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border Grid.Row="6" Margin="0,5,0,0" Style="{StaticResource DialogInputRootStyle}">
        <TextBox x:Name="PathBox" Margin="11,0" Style="{StaticResource DialogTextBoxStyle}" AutomationProperties.Name="{loc:Localize '链接或路径（src）'}" TextChanged="OnFieldTextChanged" />
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{DynamicResource BorderSubtleBrush}" />
    <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Margin="0,0,9,0" Content="{loc:Localize '取消'}" Style="{StaticResource DialogSecondaryActionButtonStyle}" Click="OnCancelClick" />
      <Button x:Name="SubmitButton" Content="{loc:Localize '保存修改'}" Style="{StaticResource DialogPrimaryActionButtonStyle}" Click="OnSubmitClick" />
    </StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
