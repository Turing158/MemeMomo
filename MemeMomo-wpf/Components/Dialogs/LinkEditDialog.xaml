<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.LinkEditDialog"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                          xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                          xmlns:ui="clr-namespace:MemeMomo.UI"
                          Title="{loc:Localize '插入链接'}"
                          Width="460"
                          Height="332"
                          MinWidth="380"
                          MinHeight="332"
                          ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                          ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                          PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="22,10,22,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Border Width="28" Height="28" VerticalAlignment="Center" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentMutedBrush}" BorderThickness="1" CornerRadius="7"><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MdLinkIcon}" Fill="{DynamicResource AccentPrimaryBrush}" /></Border>
      <TextBlock x:Name="DialogTitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{loc:Localize '插入链接'}" TextTrimming="CharacterEllipsis" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <Button Grid.Column="2" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="{loc:Localize '关闭链接面板'}" ToolTip="{loc:Localize '关闭'}" Click="OnCancelClick"><Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />
    <StackPanel Grid.Row="2" Margin="0,16,0,14">
      <TextBlock Text="{loc:Localize '链接文本'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border x:Name="LabelInputRoot" Margin="0,5,0,0" Style="{StaticResource DialogInputRootStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"><TextBlock Text="Aa" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource IconDefaultBrush}" /></Border><TextBox x:Name="LabelBox" Grid.Column="1" Margin="11,0,12,0" Style="{StaticResource DialogTextBoxStyle}" ToolTip="{loc:Localize '输入显示文字'}" AutomationProperties.Name="{loc:Localize '链接文本'}" TextChanged="OnInputTextChanged" /></Grid></Border>
      <TextBlock Margin="0,14,0,0" Text="{loc:Localize '链接地址'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border x:Name="UrlInputRoot" Margin="0,5,0,0" Style="{StaticResource DialogInputRootStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"><Path Width="15" Height="15" Stretch="Uniform" Data="{DynamicResource MdLinkIcon}" Fill="{DynamicResource IconDefaultBrush}" /></Border><TextBox x:Name="UrlBox" Grid.Column="1" Margin="11,0,4,0" Style="{StaticResource DialogTextBoxStyle}" ToolTip="https://example.com" AutomationProperties.Name="{loc:Localize '链接地址'}" TextChanged="OnInputTextChanged" /><Button x:Name="ClearUrlButton" Grid.Column="2" Width="30" Height="30" Margin="0,0,4,0" Style="{StaticResource DialogInputIconButtonStyle}" AutomationProperties.Name="{loc:Localize '清空链接地址'}" ToolTip="{loc:Localize '清空'}" Visibility="Collapsed" Click="OnClearUrlClick"><Path Width="12" Height="12" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button></Grid></Border>
    </StackPanel>
    <Border Grid.Row="3" Background="{DynamicResource BorderSubtleBrush}" />
    <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right"><Button Margin="0,0,9,0" Content="{loc:Localize '取消'}" Style="{StaticResource DialogSecondaryActionButtonStyle}" AutomationProperties.Name="{loc:Localize '取消'}" Click="OnCancelClick" /><Button x:Name="SubmitButton" Style="{StaticResource DialogPrimaryActionButtonStyle}" AutomationProperties.Name="{loc:Localize '插入链接'}" Click="OnSubmitClick"><TextBlock x:Name="SubmitButtonText" Text="{loc:Localize '插入链接'}" /></Button></StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
