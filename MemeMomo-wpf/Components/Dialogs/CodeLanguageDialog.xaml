<dialogs:MemoDialogWindow x:Class="MemeMomo.Components.Dialogs.CodeLanguageDialog"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:loc="clr-namespace:MemeMomo.UI.Text"
                         xmlns:dialogs="clr-namespace:MemeMomo.Components.Dialogs"
                         Title="{loc:Localize '编辑代码语言'}"
                         Width="440" Height="252" MinWidth="380" MinHeight="252"
                         ShellBackground="{DynamicResource SurfacePrimaryBrush}"
                         ShellBorderBrush="{DynamicResource BorderEmphasisBrush}"
                         PreviewKeyDown="OnDialogPreviewKeyDown">
  <Grid Margin="22,10,22,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
      <RowDefinition Height="1" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="{loc:Localize '编辑代码语言'}" FontSize="15.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      <Button Grid.Column="1" Style="{StaticResource DialogIconButtonStyle}" AutomationProperties.Name="{loc:Localize '关闭'}" ToolTip="{loc:Localize '关闭'}" Click="OnCancelClick">
        <Path Width="14" Height="14" Stretch="Uniform" Data="{DynamicResource CloseIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      </Button>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" />
    <StackPanel Grid.Row="2" Margin="0,14,0,10">
      <TextBlock Text="{loc:Localize '代码语言'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
      <Border x:Name="LanguageInputRoot" Margin="0,5,0,0" Style="{StaticResource DialogInputRootStyle}">
        <TextBox x:Name="LanguageBox" Margin="12,0" Style="{StaticResource DialogTextBoxStyle}" AutomationProperties.Name="{loc:Localize '代码语言'}" TextChanged="OnLanguageChanged" />
      </Border>
      <TextBlock Margin="0,5,0,0" Text="{loc:Localize '例如 csharp、python；留空可移除语言标签。'}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
    <Border Grid.Row="3" Background="{DynamicResource BorderSubtleBrush}" />
    <StackPanel Grid.Row="4" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Margin="0,0,9,0" Content="{loc:Localize '取消'}" Style="{StaticResource DialogSecondaryActionButtonStyle}" Click="OnCancelClick" />
      <Button x:Name="SubmitButton" Content="{loc:Localize '保存修改'}" Style="{StaticResource DialogPrimaryActionButtonStyle}" Click="OnSubmitClick" />
    </StackPanel>
  </Grid>
</dialogs:MemoDialogWindow>
