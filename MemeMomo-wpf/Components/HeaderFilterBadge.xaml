<UserControl x:Class="MemeMomo.Components.HeaderFilterBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MemeMomo.UI"
             Focusable="False" Loaded="OnLoaded" Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged" IsVisibleChanged="OnIsVisibleChanged" IsEnabledChanged="OnIsEnabledChanged">
  <Grid ClipToBounds="True">
    <Button x:Name="BadgeButton" Width="24" Height="32" HorizontalAlignment="Left"
            Click="OnClick" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave"
            PreviewMouseDown="OnPreviewMouseDown" PreviewKeyDown="OnPreviewKeyDown"
            GotKeyboardFocus="OnGotKeyboardFocus" LostKeyboardFocus="OnLostKeyboardFocus"
            ContextMenuOpening="OnContextMenuOpening">
      <Button.Style>
        <Style TargetType="Button">
          <Setter Property="FocusVisualStyle" Value="{StaticResource MemoFocusVisualStyle}" />
          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                  <Border x:Name="BadgeSurface" Height="24" CornerRadius="12" Background="{DynamicResource AccentSubtleBrush}"
                          Padding="5,0" VerticalAlignment="Center" ClipToBounds="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BadgeSurface" Property="Background">
                      <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource AccentMuted}" Opacity="0.45" />
                      </Setter.Value>
                    </Setter>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BadgeSurface" Property="Background" Value="{DynamicResource AccentMutedBrush}" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Button.Style>
      <Grid x:Name="BadgeContent" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="CountText" Text="0" Style="{StaticResource CountBadgeTextStyle}" />
        <Grid x:Name="BadgeTail" Grid.Column="1" Width="0" ClipToBounds="True">
          <Viewbox x:Name="ActiveFilterMark" Width="10" Height="10" Margin="4,0,0,0"
                   HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0" Visibility="Collapsed">
            <ui:TaskStatusIcon Width="16" Height="16" IconKey="Filter" Foreground="{DynamicResource AccentPrimaryBrush}" />
          </Viewbox>
          <Grid x:Name="Details" Margin="3,0,0,0" Opacity="0" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Viewbox x:Name="ExpandArrow" Grid.Column="1" Width="8" Height="8" Margin="2,0,0,0" VerticalAlignment="Center">
              <ui:TaskStatusIcon Width="16" Height="16" IconKey="ChevronDown" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </Viewbox>
          </Grid>
        </Grid>
      </Grid>
    </Button>
  </Grid>
</UserControl>
