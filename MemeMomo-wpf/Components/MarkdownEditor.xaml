<UserControl x:Class="MemeMomo.Components.MarkdownEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:popup="clr-namespace:MemeMomo.UI.Popup"
             AllowDrop="True"
             DragEnter="OnDragEnter"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop">
  <UserControl.Resources>
    <!-- AvalonEdit renders the editor scrollbar (main window and popout memo)
         with the system chrome; scope the overlay hairline style to this
         control so the memo list and dialogs keep their own scrollbar looks. -->
    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource EditorOverlayScrollBarStyle}" />
  </UserControl.Resources>
  <Border x:Name="Surface" Style="{StaticResource MarkdownEditorSurfaceStyle}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="Toolbar" Style="{StaticResource MarkdownEditorToolbarStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="FormatToolbar" Orientation="Horizontal">
            <Button x:Name="BoldButton" Tag="Bold" AutomationProperties.Name="粗体" ToolTip="粗体 (Ctrl+B)" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontSize="16" FontWeight="Bold" Text="B" /></Button>
            <Button x:Name="ItalicButton" Tag="Italic" AutomationProperties.Name="斜体" ToolTip="斜体 (Ctrl+I)" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontSize="16" FontStyle="Italic" Text="I" /></Button>
            <Button x:Name="HeadingButton" AutomationProperties.Name="标题" ToolTip="标题" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnHeadingClick" MouseLeave="OnToolbarMenuAnchorMouseLeave">
              <TextBlock FontSize="16" FontWeight="Bold" Text="h" />
              <Button.ContextMenu>
                <ContextMenu x:Name="HeadingMenu" popup:ContextMenuAnimations.IsEnabled="True" Style="{StaticResource MarkdownToolbarMenuPresenterTheme}" Opened="OnToolbarMenuOpened" Closed="OnToolbarMenuClosed" MouseEnter="OnToolbarMenuMouseEnter" MouseLeave="OnToolbarMenuMouseLeave">
                  <MenuItem Tag="Heading" Header="H1  一级标题" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick" />
                  <MenuItem Tag="Heading2" Header="H2  二级标题" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick" />
                  <MenuItem Tag="Heading3" Header="H3  三级标题" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick" />
                  <MenuItem Tag="Heading4" Header="H4  四级标题" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="StrikeButton" Tag="Strikethrough" AutomationProperties.Name="删除线" ToolTip="删除线" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontSize="14" Text="S" TextDecorations="Strikethrough" /></Button>
            <Button x:Name="TableButton" AutomationProperties.Name="表格" ToolTip="表格" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnTableClick"><Path Width="16" Height="16" Data="{DynamicResource MdTableIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
            <Button x:Name="BulletListButton" Tag="BulletList" AutomationProperties.Name="无序列表" ToolTip="无序列表" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><Path Width="15" Height="15" Data="{DynamicResource MdListIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
            <Button x:Name="OrderedListButton" Tag="OrderedList" AutomationProperties.Name="有序列表" ToolTip="有序列表" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="1." /></Button>
            <Button x:Name="TaskListButton" Tag="TaskList" AutomationProperties.Name="任务列表" ToolTip="任务列表" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold" Text="[ ]" /></Button>
            <Button x:Name="QuoteButton" Tag="Quote" AutomationProperties.Name="引用" ToolTip="引用" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold" Text="&gt;" /></Button>
            <Button x:Name="InlineCodeButton" Tag="InlineCode" AutomationProperties.Name="行内代码" ToolTip="行内代码" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Text="&lt;/&gt;" /></Button>
            <Button x:Name="CodeBlockButton" Tag="CodeBlock" AutomationProperties.Name="代码块" ToolTip="代码块" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="```" /></Button>
            <Button x:Name="HorizontalRuleButton" Tag="HorizontalRule" AutomationProperties.Name="分隔线" ToolTip="分隔线" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="---" /></Button>
            <Button x:Name="LinkButton" Tag="Link" AutomationProperties.Name="链接" ToolTip="链接" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><Path Width="16" Height="16" Data="{DynamicResource MdLinkIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
            <Button x:Name="LocalImageButton" Tag="LocalImage" AutomationProperties.Name="本地图片" ToolTip="本地图片" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><Path Width="16" Height="16" Data="{DynamicResource MdImageIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
            <Button x:Name="RemoteImageButton" Tag="RemoteImage" AutomationProperties.Name="网络图片" ToolTip="网络图片" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><Path Width="16" Height="16" Data="{DynamicResource MdRemoteImageIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
          </StackPanel>
          <StackPanel x:Name="ToolbarActions" Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="EditSourceButton" Tag="EditSource" AutomationProperties.Name="编辑源码" ToolTip="编辑源码" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick"><TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold" Text="MD" /></Button>
            <Button x:Name="MoreButton" AutomationProperties.Name="更多格式" ToolTip="更多格式" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnMoreClick" MouseLeave="OnToolbarMenuAnchorMouseLeave">
              <Path Width="16" Height="16" Data="{DynamicResource MdMoreIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
              <Button.ContextMenu>
                <ContextMenu x:Name="MoreMenu" popup:ContextMenuAnimations.IsEnabled="True" Style="{StaticResource MarkdownToolbarMenuPresenterTheme}" Opened="OnToolbarMenuOpened" Closed="OnToolbarMenuClosed" MouseEnter="OnToolbarMenuMouseEnter" MouseLeave="OnToolbarMenuMouseLeave">
                  <MenuItem x:Name="TableMenuItem" Tag="Table" AutomationProperties.Name="表格" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="4,0,12,0" Data="{DynamicResource MdTableIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Stretch="Uniform" /><TextBlock Text="表格" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="BulletListMenuItem" Tag="BulletList" AutomationProperties.Name="无序列表" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="4,0,12,0" Data="{DynamicResource MdListIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Stretch="Uniform" /><TextBlock Text="无序列表" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="OrderedListMenuItem" Tag="OrderedList" AutomationProperties.Name="有序列表" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="1." TextAlignment="Center" /><TextBlock Text="有序列表" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="TaskListMenuItem" Tag="TaskList" AutomationProperties.Name="任务列表" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold" Text="[ ]" TextAlignment="Center" /><TextBlock Text="任务列表" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="QuoteMenuItem" Tag="Quote" AutomationProperties.Name="引用" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold" Text="&gt;" TextAlignment="Center" /><TextBlock Text="引用" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="InlineCodeMenuItem" Tag="InlineCode" AutomationProperties.Name="行内代码" IsCheckable="True" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="9.5" FontWeight="SemiBold" Text="&lt;/&gt;" TextAlignment="Center" /><TextBlock Text="行内代码" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="CodeBlockMenuItem" Tag="CodeBlock" AutomationProperties.Name="代码块" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="```" TextAlignment="Center" /><TextBlock Text="代码块" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="HorizontalRuleMenuItem" Tag="HorizontalRule" AutomationProperties.Name="分隔线" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" FontWeight="SemiBold" Text="---" TextAlignment="Center" /><TextBlock Text="分隔线" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="LinkMenuItem" Tag="Link" AutomationProperties.Name="链接" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="4,0,12,0" Data="{DynamicResource MdLinkIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Stretch="Uniform" /><TextBlock Text="链接" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="LocalImageMenuItem" Tag="LocalImage" AutomationProperties.Name="本地图片" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="4,0,12,0" Data="{DynamicResource MdImageIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Stretch="Uniform" /><TextBlock Text="本地图片" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <MenuItem x:Name="RemoteImageMenuItem" Tag="RemoteImage" AutomationProperties.Name="网络图片" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="4,0,12,0" Data="{DynamicResource MdRemoteImageIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}" Stretch="Uniform" /><TextBlock Text="网络图片" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                  <Separator x:Name="ResponsiveMenuSeparator" Style="{StaticResource MarkdownToolbarMenuSeparatorTheme}" />
                  <MenuItem x:Name="EditSourceMenuItem" Tag="EditSource" AutomationProperties.Name="编辑源码" Style="{StaticResource MarkdownToolbarMenuItemTheme}" Click="OnMenuCommandClick">
                    <MenuItem.Header><StackPanel Orientation="Horizontal"><TextBlock Width="24" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" FontWeight="SemiBold" Text="MD" TextAlignment="Center" /><TextBlock Text="编辑源码" /></StackPanel></MenuItem.Header>
                  </MenuItem>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button x:Name="SaveButton" Tag="Save" AutomationProperties.Name="立即保存" ToolTip="立即保存 (Ctrl+Enter)" Style="{StaticResource MarkdownSaveButtonStyle}" Click="OnToolbarClick"><Path Width="16" Height="16" Data="{DynamicResource MdSaveIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
            <Button x:Name="NewButton" Tag="New" AutomationProperties.Name="新建备忘录" ToolTip="新建备忘录" Style="{StaticResource MarkdownToolButtonStyle}" Click="OnToolbarClick" Visibility="Collapsed"><Path Width="16" Height="16" Data="{DynamicResource MdNewIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="EditorHost" Grid.Row="1" MinHeight="58">
        <ContentPresenter Content="{Binding EditorContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <Button x:Name="CodeCopyButton" HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.Name="复制代码" ToolTip="复制代码" Style="{StaticResource CodeBlockCopyButtonStyle}" Visibility="Collapsed" Click="OnCodeCopyClick"><Path Width="12" Height="12" Data="{DynamicResource MdCopyIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" /></Button>
        <TextBlock x:Name="WatermarkText" Margin="13,11" Foreground="{DynamicResource TextDisabledBrush}" IsHitTestVisible="False" Text="写点什么…" />
        <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="7,3" CornerRadius="6" Background="{DynamicResource BgTertiaryBrush}" IsHitTestVisible="False" Opacity="0">
          <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
        <Border x:Name="DropCue" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderFocusBrush}" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False" Opacity="0">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" Text="放开以插入图片" />
        </Border>
      </Grid>
      <Popup x:Name="TablePickerPopup" popup:PopupAnimations.IsEnabled="True" Placement="Bottom" PlacementTarget="{Binding ElementName=TableButton}" AllowsTransparency="True" Closed="OnTablePickerClosed">
        <Border x:Name="TablePickerSurface" Style="{StaticResource MarkdownTablePickerPresenterTheme}">
          <StackPanel>
            <TextBlock x:Name="TableSizeLabel" Margin="2,0,2,5" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="表格" />
            <UniformGrid x:Name="TableSizeGrid" Rows="9" Columns="9" MouseLeave="OnTablePickerMouseLeave" />
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</UserControl>
